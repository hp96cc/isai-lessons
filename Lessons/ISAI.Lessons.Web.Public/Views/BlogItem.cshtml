@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.BlogItem>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}



<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>
                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {


                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }

                        <li><a href="javascript:void(0)">@Model.Title</a></li>

                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
<!-- start blog details section -->
<section class="blogs">
    <div class="container">
        <div class="row">

            <!--  start blog left-->
            <div class="col-12 sm-margin-50px-bottom">
                <div class="posts">

                    <div class="post">
                        <div class="post-img position-relative margin-30px-bottom">
                            <a href="javascript:void(0);" class="width-100">
                                <img src="@Model.BlogImage.MediaUrl()" class="border-radius-5" alt="@Model.Title">
                                <div class="date position-absolute bg-green">
                                    <span class="display-block text-white font-size28 md-font-size26 sm-font-size24">@Model.BlogDate.Day</span>
                                    <p class="text-white font-size16 md-font-size14 no-margin-bottom">@Model.BlogDate.ToString("MMM")</p>
                                </div>
                            </a>
                        </div>
                        <div class="content">
                            <div class="post-meta">
                                <div class="post-title">
                                    <h5>@Model.Title</h5>
                                </div>
                                <ul class="meta">
                                    <li>
                                        <a href="javascript:void(0);">
                                            <i class="fa fa-user text-green" aria-hidden="true"></i> @Model.BlogAuthor
                                        </a>
                                    </li>
                                    <li>
                                        <a href="javascript:void(0);">
                                            <i class="fa fa-calendar text-green" aria-hidden="true"></i>  @Model.BlogDate.ToLongDateString()
                                        </a>
                                    </li>
                                    @*<li>
                                        <a href="javascript:void(0);">
                                            <i class="fa fa-comments text-green" aria-hidden="true"></i> 4 Comments
                                        </a>
                                    </li>*@
                                </ul>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.QuoteContent))
                            {

                            <div class="post-cont">
                                @Model.ContentArea1
                                <div class="special">
                                    <h4 class="margin-10px-bottom font-weight-500 font-size26 sm-font-size22 xs-font-size18">@Model.QuoteContent</h4>
                                    <span class="font-size16 text-light-pink">@Model.QuoteAuthor</span>
                                </div>
                                @Model.ContentArea2
                            </div>

                            }

                            @*<div class="share-post">
