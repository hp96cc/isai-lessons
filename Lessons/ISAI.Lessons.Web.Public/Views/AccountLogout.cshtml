@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountLogout>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


}

<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="/">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Signout
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">


        <div class="row" id="account-panel">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "logout" } })


            </div>
            <div class="col-9">
                <div class="row">


                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">Signout</h3>

                        <p>Are you sure you wish to signout?</p>

                        <!-- Button -->
                        <button class="butn x-small mt-2" type="button" onclick="lessonsApp.logout('/account/?redirectUrl=/account/info');">Signout</button>
                    </div>



                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {

    <script>

        $(document).ready(function ()
        {
            HidePreloader();

        });

    </script>
}