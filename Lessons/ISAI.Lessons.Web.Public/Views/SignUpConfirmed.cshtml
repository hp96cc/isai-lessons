@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.SignUpConfirmed>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()" style="background-image: url(@Model.BackgroundImage.MediaUrl());">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <p><strong>@Model.Subtitle </strong></p>
        </div>
    </div>
</section>



<section class="pt-2">
    <div class="container">

        <div class="row justify-content-center mt-3" >
            <div class="col-6 text-center">

          
                <a type="button" class="butn x-small green p-2 pl-3 pr-3 mb-2" href="/lessons">View Lessons</a>



            </div>
        </div>



    </div>


</section>
