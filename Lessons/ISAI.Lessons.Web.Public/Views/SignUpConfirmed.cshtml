@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.SignUpConfirmed>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()" style="background-image: url(@Model.BackgroundImage.MediaUrl());">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <p><strong>@Model.Subtitle </strong></p>
        </div>
    </div>
</section>

<section class="pt-2">
    <div class="container">
        <div class="section-heading">


            <span class="title-separator"></span>
        </div>
        <div class="row">
            <div class="col text-center h3">

                @Model.PageContent
            </div>
        </div>
    </div>
</section>