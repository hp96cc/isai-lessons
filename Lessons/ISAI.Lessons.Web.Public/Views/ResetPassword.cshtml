@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.ResetPassword>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";


}



<section class="page-title-section bg-img cover-background p-5" data-overlay-dark="0" data-background="https://scottishonlinelessons.com//media/1f3fd5lm/blue-header-background.png">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>

                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {

                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-8 center-col">

                <div class="block-info">
                    <h6 class="bg-sky">@Model.Title</h6>

                    <div class="spinner-border mb-10 p-2" role="status" id="spinner-loading" style="display:none;">
                        <span class="sr-only">Loading...</span>
                    </div>



                    <div class="padding-50px-all md-padding-50px-all sm-padding-25px-all" id="account-panel">
                        @Model.Content

                        <form method="post" id="password-form">

                            <input type="hidden" id="digest" value="@Request.QueryString["digest"]" />

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Password *:</label>
                                        <input type="password" class="form-control" name="password" id="password" autocomplete="new-password" required />
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Confirm Password *:</label>
                                        <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" autocomplete="new-password" required />
                                    </div>
                                </div>

                                <div class="col-md-12 margin-25px-top">

                                    <div id="error-label" class="alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">
                                        An error has occured. 
                                    </div>


                                    <button type="button" class="butn yellow btn-block" onclick="ResetPassword();">Update Password</button>
                                </div>



                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <script>

        

        async function ResetPassword() {

            var form = document.getElementById("password-form");
            $("#error-label").hide();

            if (form.checkValidity() === false) {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else {

                $('#account-panel').hide();
                ShowPreloader();

                var requestModel = {

                    Password: $('#password').val(),
                    ConfirmPassword: $('#confirmPassword').val(),
                    Digest: $('#digest').val()
                };

                var result = await lessonsApp.updatePassword(requestModel);

                $('#account-panel').show();
                HidePreloader();

                if (result && result.Status === 0) {
                    window.location.href = "/account/";
                }
                else {

                    if (result && result.ErrorResponse) {
                        $("#error-label").text(result.ErrorResponse[0].Message);
                    }
                    else
                    {
                        $("#error-label").text("An error has occured. ");
                    }

                    $("#error-label").show();
                }


            }

        }

    </script>

}
