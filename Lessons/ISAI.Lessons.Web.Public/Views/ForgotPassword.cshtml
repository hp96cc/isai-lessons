@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.ForgotPassword>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = null;
}


<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow" data-overlay-dark="0" data-background="img/bg/bg1.jpg">
    <div class="container">
        <div class="page-title">
            <h1>Forgot Password</h1>
            <div class="page-link">
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li><a href="javascript:void(0)">Forgot Password</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
<!-- start login section -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-8 center-col">

                <div class="block-info">
                    <h6 class="bg-sky">Forgot Password</h6>

                    <div class="padding-50px-all md-padding-50px-all sm-padding-25px-all">
                        <form method="post">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Email *:</label>
                                        <input type="email" class="form-control" name="email" />
                                    </div>
                                </div>

                                <div class="col-md-12 margin-25px-top">
                                    <button type="submit" class="butn yellow small btn-block">Request Reset Link</button>
                                </div>

                                <div class="col-md-12 text-center margin-25px-top">
                                    <span>Remember password? <a href="login.html">Login</a></span>
                                </div>

                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
<!-- end login section -->