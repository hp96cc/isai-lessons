@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.ForgotPassword>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";


    var canonicalUrl = "https://" + Request.ServerVariables["HTTP_HOST"] + Model.Url();


}



<section class="page-title-section bg-img cover-background p-5" data-overlay-dark="0" data-background="https://portal.scottishonlinelessons.com//media/1f3fd5lm/blue-header-background.png">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>

                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {

                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-8 center-col">

                <div class="block-info">
                    <h6 class="bg-sky">@Model.Title</h6>

                    <div class="spinner-border mb-10 p-2" role="status" id="spinner-loading" style="display:none;">
                        <span class="sr-only">Loading...</span>
                    </div>

                    <div id="success-label" class="alert alert-success m-3 delivery-error-label" role="alert" style="display:none;">
                        Your password reset request has been sent.
                    </div>


                    <div class="padding-50px-all md-padding-50px-all sm-padding-25px-all" id="account-panel">
                        @Model.Content



                        <form method="post" id="password-form">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Email *:</label>
                                        <input type="email" class="form-control" name="email" id="email" required />
                                    </div>
                                </div>




                                <div id="error-label" class="alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">
                                    An error has occured.
                                </div>

                                <div class="col-md-12 margin-25px-top">
                                    <button type="button" class="butn yellow btn-block" onclick="SendEmail()">Request Reset Link</button>
                                </div>



                            </div>

                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <script>

        var appId = 1;

        async function SendEmail() {

            var form = document.getElementById("password-form");
            $("#error-label").hide();
            $("#success-label").hide();

            if (form.checkValidity() === false) {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else {

                $('#account-panel').hide();
                ShowPreloader();

                var requestModel = {

                    AppId: appId,
                    Email: $('#email').val()
                };

                var result = await lessonsApp.sendPasswordResetEmail(requestModel);

               
                HidePreloader();
             

                if (result && result.Status === 0) {
                    $("#success-label").show();
                }
                else {

                    if (result && result.ErrorResponse) {
                        $("#error-label").text(result.ErrorResponse[0].Message);
                    }
                    else
                    {
                        $("#error-label").text("An error has occured. ");
                    }

                    $('#account-panel').show();
                    $("#error-label").show();
                }


            }

        }

    </script>

}
