@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountDevices>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        My Devices
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">


                <div class="row" id="account-panel">
                    <div class="col-3">

                        <!-- Nav -->
                        @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "devices" } })


                    </div>
                    <div class="col-9">
                        <div class="row">

                          
                                <div class="col-12">

                                    <!-- Heading -->
                                    <h3 class="mb-10">My Devices</h3>
                                    <p>The table below shows your registered devices. You can register up to 2 devices at any one time.</p>



                                </div>
                         

                            <div class="col-12 p-1">
                                <div class="row" id="device-list"></div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
</section>

<div class="modal fade" id="deleteDeviceModal" tabindex="-1" role="dialog" aria-labelledby="deleteDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteDeviceModalLabel">Delete Device</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you wish to delete this device? You will no longer be able to access any lesson content on this device after it has been deleted.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" onclick="DeleteDevice();">Yes</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <template id="template-device">

        <div class="col-12 p-0">
            <div class="card-body pt-0">

                <!-- Info -->
                <div class="card card-sm">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-10">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">Device Name:</h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm font-weight-bold">
                                    {{Name}}
                                </p>

                            </div>
                   
                            <div class="col-2 float-right">

                 
                                <!-- Button -->
                                <button class="btn btn-circle float-right p-0" data-toggle="modal" data-target="#deleteDeviceModal" onclick="PromptdeleteDevice({{Id}});">
                                    <i class="far fa-trash-alt delete-button"></i>
                                </button>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
            
        </div>


    </template>


    <script>

        var deleteDeviceId;
        var devices;

        $(document).ready(function () {

            GetDevices();
         
        });


        async function GetDevices() {


            var data = await lessonsApp.getCustomerDevices();

            if (!data) {
                lessonsApp.logout();
            }
            else if (data.Status !== 0) 
            {
                location.href = '/account/'
            }
            else
            {
                devices = data.Content;
                DisplayDevices();
            }


        }

        async function DisplayDevices() {

            $('#device-list').html('');

            var itemListHTML = '';
            var templateItem = $('#template-device').html();

            devices.forEach(function (item) {

                itemListHTML += Mustache.render(templateItem, item);

            });


            $('#device-list').html(itemListHTML);

            HidePreloader();


        }



        function PromptdeleteDevice(id) {

            deleteDeviceId = id;

        }

        async function DeleteDevice() {


            ShowPreloader()

            var data = await lessonsApp.deleteCustomerDevice({ Id: deleteDeviceId});

            if (!data) {
                lessonsApp.logout();
            }
            else if (data.Status !== 0) 
            {
                location.href = '/account/'
            } else {

                GetDevices();
            }



        }


    </script>




}
