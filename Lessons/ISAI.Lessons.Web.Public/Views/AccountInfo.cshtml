@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountInfo>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        My Details
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>


<!-- CONTENT -->
<section class="p-0">
    <div class="container">

        

        <div class="row" id="account-panel">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "info" } })


            </div>
            <div class="col-9">
                <div class="row">

              
                        <div class="col-12">

                            <!-- Heading -->
                            <h3 class="mb-10">My Details</h3>
                            <p>Your details are below. If you wish to make changes, please adjust as correct and click the 'Save Changes' button</p>

                        </div>
                    </div>

                    <div class="col-12 p-1 pt-3">
             
                            <!-- Form -->
                        <form id="account-form" class="needs-validation" novalidate>
                            <div class="row">

                                <div class="col-12">

                                    <!-- Email -->
                                    <div class="form-group">
                                        <label for="accountFirstName">
                                            First Name *
                                        </label>
                                        <input class="form-control form-control-sm" id="accountFirstName" type="text" placeholder="First Name *" required>
                                    </div>

                                </div>
                                <div class="col-12">
                                    <!-- Email -->
                                    <div class="form-group">
                                        <label for="accountLastName">
                                            Last Name *
                                        </label>
                                        <input class="form-control form-control-sm" id="accountLastName" type="text" placeholder="Last Name *" required>
                                    </div>

                                </div>

                                <div class="col-12">

                                    <!-- Email -->
                                    <div class="form-group">
                                        <label for="accountEmail">
                                            Email Address
                                        </label>
                                        <input class="form-control form-control-sm" id="accountEmail" type="email" placeholder="Email Address" readonly aria-readonly="true">
                                    </div>

                                </div>


                                <div class="col-12 ">

                                    <!-- Email -->
                                    <div class="form-group">
                                        <label for="accountEmail">
                                            Phone Number *
                                        </label>
                                        <input class="form-control form-control-sm" id="accountPhone" type="tel" placeholder="Phone">
                                    </div>

                                </div>


                                <div class="col-12">

                                    <!-- Button -->
                                    <button class="butn x-small float-right p-2 pl-4 pr-4 ml-4 mb-2 mt-3" type="button" onclick="SaveCustomer();">Save Changes</button>

                                   

                                </div>

                                <div class="col-12">
                                    <div id="account-error-label" class="alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">
                                        Cound not save details
                                    </div>

                                    <div id="label-saved" class="alert alert-success alert-dismissible fade show mt-4" role="alert" style="display:none;">
                                        Your details have been saved

                                    </div>
                                </div>
                                </div>
</form>

                      


              
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {

    <script>

        $(document).ready(function () {

            GetCustomer();

        });

        var customer;

        async function GetCustomer() {

            var data = await lessonsApp.getCustomer();

            if (!data) {
                lessonsApp.logout('/account/?redirectUrl=@(Url.Encode(Model.Url()))');
            }
            else if (data.Status !== 0)
            {
                location.href = '/account/?redirectUrl=@(Url.Encode(Model.Url()))';
            }
            else
            {
                HidePreloader();
                customer = data.Content;
                DisplayCustomer();
            }


        }


        function DisplayCustomer() {

            $('#accountFirstName').val(customer.FirstName);
            $('#accountLastName').val(customer.LastName);
            $('#accountEmail').val(customer.Email);
            $('#accountPhone').val(customer.Telephone);

            $('#account-panel').show();
            $('#spinner-loading').hide();

        }

        async function SaveCustomer() {

            $("#label-saved").hide();
            $("#account-error-label").hide();

            var form = document.getElementById("account-form");

            if (form.checkValidity() === false) {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else {

                var url = "/api/lessonapp/savecustomer";

                var customer = {
                    FirstName: $('#accountFirstName').val(),
                    LastName: $('#accountLastName').val(),
                    Email: $('#accountEmail').val(),
                    Telephone: $('#accountPhone').val()
                };

                var data = await lessonsApp.saveCustomer(customer);

                $('#account-panel').show();
                $('#spinner-loading').hide();

            if (data.Status === 0) {

                $("#label-saved").show();
            }
            else
            {
                var errorMessage = 'Could not save details';

                if (data.ErrorResponse !== null && data.ErrorResponse.length > 0) {
                    errorMessage = data.ErrorResponse[0].Message;
                }

                $("#account-error-label").text(errorMessage);
                $("#account-error-label").show();
            }


            }

        }


    </script>

}
