@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountGroupTutorials>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Group Tutorials
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">



        <div class="row">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "group-tutorials" } })


            </div>
            <div class="col-9">
                <div class="row">

                 
                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">Group Tutorials</h3>
                        <p>Below is a list of our pre-planned Group Tutorials. </p>



                    </div>


                    <div class="col-12 p-1">
                        <div class="row" id="tutorial-list"></div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <template id="template-tutorial">

        <div class="col-12 p-0">
            <div class="card-body pt-0">

                <!-- Info -->
                <div class="card card-sm">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-10">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">
                                    {{Date}} @@ {{TimeStart}} to {{TimeEnd}}

                                    {{#IsUserSignedUp}}
                                    &nbsp;&nbsp;&nbsp;<span class="mr-3 badge badge-primary p2" style="background-color: #ff457e;">Signed Up</span>

                                    {{/IsUserSignedUp}}
                                </h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm">
                                    <span class=" font-weight-bold">{{Name}}</span><br />
                                    {{Description}}
                                </p>

                             

                            </div>
                        


                        </div>
                        <div class="row">
                            <div class="col-10 mt-2">

                                

                                {{^IsUserSignedUp}}

                                <a href="/tutorials/confirm-group-tutorial?groupTutorialId={{Id}}"  class="butn x-small green p-2 pl-3 pr-3 mb-2"><span>Book Tutorial</span></a>

                                {{/IsUserSignedUp}}

                               

                            </div>

                        </div>

                    </div>

                </div>


    </template>

    <script>

        var tutorials = [];

        $(document).ready(function ()
        {
            GetGroupTutorials();
        });


        async function GetGroupTutorials()
        {

            var data = await lessonsApp.grouptutorials();

            if (!data)
            {
               //lessonsApp.logout('/account/');
            }
            else if (data.Status !== 0)
            {
                //location.href = '/account/';
            }
            else
            {
                HidePreloader();
                tutorials = data.Content.Tutorials;
                DisplayGroupTutorials();
            }


        }

        async function DisplayGroupTutorials()
        {

            $('#tutorial-list').html('');

            var itemListHTML = '';
            var templateItem = $('#template-tutorial').html();

            tutorials.forEach(function (item)
            {
                item.IsGroupTutorial = item.GroupTutorialId ? true : false;
                itemListHTML += Mustache.render(templateItem, item);

            });


            $('#tutorial-list').html(itemListHTML);

            $('#spinner-loading').hide();


        }

    </script>
}

