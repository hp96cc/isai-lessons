@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.GroupTutorialPublic>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<!-- BREADCRUMB -->
<!-- CONTENT -->
<section class="p-0 pt-5">
    <div class="container">



        <div class="row">

            <div class="col-12">
                <div class="row">


                    <div class="col-12 text-center">

                        <!-- Heading -->
                        <h3 class="mb-10">Group Tutorials</h3>
                        <p class="mb-10">Below is a list of our pre-planned Group Tutorials. </p>
                        <h4 class="mb-10">To book your spot, register for an account for FREE.</h4>



                    </div>


                    <div class="col-12 p-1">



                        <div class="row" id="tutorial-list"></div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" id="confirmTutorialModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmTutorialModalLabel">Book Group Tutorial</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">

                <p>Register with Scottish Online Lessons for free and book your group sessions today!</p>

                <button type="button" class="butn x-small green m-3" style="min-width:125px;" onclick="RedirectToLogin()" data-dismiss="modal">Login</button>

                <button type="button" class="butn x-small green m-3" style="min-width:125px;" onclick="RedirectToSignup()" data-dismiss="modal">Register for Free</button>

            </div>
            <div class="modal-footer">

            </div>
        </div>
    </div>
</div>


@section Scripts {



    <template id="template-tutorial-group-link">


        <a href="#tg-{{Id}}" class="butn x-small pink float-right  m-3 mb-4"><span>{{Name}}</span></a>

    </template>


    <template id="template-tutorial-group">
        <div id="tg-{{Id}}"></div>
        <div class="col-12 p-0">
            <div class="card-body pt-0">

                <h4>{{Name}}</h4>
            </div>

        </div>


    </template>


    <template id="template-tutorial">

        <div class="col-12 col-md-6 p-0">
            <div class="card-body pt-0">

                <!-- Info -->
                <div class="card card-sm">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-10">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">
                                    {{Date}} @@ {{TimeStart}} to {{TimeEnd}}


                                </h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm">
                                    <span class=" font-weight-bold">{{Name}}</span><br />
                                    {{Description}}
                                </p>

                                <p class="mt-2"><strong>Cost: £15</strong></p>



                            </div>



                        </div>
                        <div class="row">
                            <div class="col-10 mt-2">



                                <a href="#" onclick="BookTutorial({{Id}})" class="butn x-small green p-2 pl-3 pr-3 mb-2"><span>Book Tutorial</span></a>


                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


    </template>
    <script>

        var tutorials = [];
        var groupTutorialGroups = [];
        var selectedTutorialId;

        $(document).ready(function ()
        {
            GetGroupTutorials();
        });


        async function GetGroupTutorials()
        {

            var data = await lessonsApp.grouptutorialspublic();

            if (!data)
            {
                lessonsApp.logout('/account/');
            }
            else if (data.Status !== 0)
            {
                location.href = '/account/';
            }
            else
            {
                HidePreloader();
                tutorials = data.Content.Tutorials;
                groupTutorialGroups = data.Content.GroupTutorialGroups;
                DisplayGroupTutorials();
            }


        }

        async function DisplayGroupTutorials()
        {

            $('#tutorial-list').html('');

            var itemLinkListHTML = '';
            var itemListHTML = '';

            var templateGroupItemLink = $('#template-tutorial-group-link').html();
            var templateGroupItem = $('#template-tutorial-group').html();
            var templateItem = $('#template-tutorial').html();

            groupTutorialGroups.forEach(function (item)
            {

                if (item.Tutorials != null && item.Tutorials.length > 0)
                {

                    itemLinkListHTML += Mustache.render(templateGroupItemLink, item);

                    itemListHTML += Mustache.render(templateGroupItem, item);

                    item.Tutorials.forEach(function (tutorial)
                    {
                        tutorial.IsGroupTutorial = tutorial.GroupTutorialId ? true : false;
                        itemListHTML += Mustache.render(templateItem, tutorial);

                    });

                }

            });


            $('#tutorial-list').html(itemLinkListHTML + itemListHTML);

            $('#spinner-loading').hide();


        }

        function BookTutorial(groupTutorialId)
        {
            selectedTutorialId = groupTutorialId;
            $('#confirmTutorialModal').modal('show');

        }

        function RedirectToSignup()
        {
            window.location.href = '/plans/signup?redirectUrl=/tutorials/confirm-group-tutorial/?groupTutorialId=' + selectedTutorialId;

        }

        function RedirectToLogin()
        {
            window.location.href = '/account/?redirectUrl=/tutorials/confirm-group-tutorial/?groupTutorialId=' + selectedTutorialId;

        }

    </script>
}

