@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.LessonGroup>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";



}


@helper RenderChildren(LessonGroup lessonGroup)
{



    <div class="row">

        <div class="col-12 text-center">
            <h3> @lessonGroup.Title</h3>
            <span class="title-separator"></span>
        </div>

        @if (lessonGroup.Children != null && lessonGroup.Children.Count() > 0)
        {

            var childLessons = lessonGroup.Children<LessonItem>
                ();

            if (childLessons != null && childLessons.Count() > 0)
            {



                foreach (var childLesson in childLessons)
                {

                    <div class="col-md-6 col-lg-4 margin-25px-bottom xs-margin-15px-bottom">
                        <div class="courses-block">
                            <div class="courses-pic">
                                <a href="@childLesson.Url()">

                                    @*<img src="/assets/lessonthumbs/thumb_@(childLesson.MediaId.Trim()).jpg" alt="@childLesson.Title" />*@
                                    <img src="/VideoHandler.ashx?lessonId=@(childLesson.MediaId.Trim()).jpg" alt="@childLesson.Title" />
                                </a>
                            </div>
                            <div class="course-desc">
                                <h4> <a href="@childLesson.Url()">@childLesson.Title</a></h4>
                            </div>
                           
                        </div>
                    </div>

                }


            }
            else
            {

                var childLessonGroups = lessonGroup.Children<LessonGroup>
                    ();

                foreach (var childLessonGroup in childLessonGroups)
                {
                    @RenderChildren(childLessonGroup);
                }

            }


        }

    </div>


}

@{

    string backgroundImage = "/media/1f3fd5lm/blue-header-background.png";

    if (Model.BackgroundImage != null)
    {
        backgroundImage = Model.BackgroundImage.MediaUrl();
    }

}


<!-- start page title section -->
<section class="page-title-section bg-img cover-background  p-5" data-overlay-dark="0" data-background="@backgroundImage">
    <div class="container">



        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>


                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {


                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }


                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->

@if (Model.ShowLessonsAsList)
{
    <section>
        <div class="container">



            @*<div class="section-heading mb-2">
                    <h3>@Model.Title</h3>


                    <span class="title-separator"></span>
                </div>*@

            <div class="row no-gutters">

                <div class="col"> @Model.HTmlcontent</div>



                @{

                    var childLessonGroups = Model.Children<LessonGroup>();

                    if (childLessonGroups != null && childLessonGroups.Count() > 0)
                    {


                        foreach (LessonGroup childLessonGroup in childLessonGroups)
                        {
                            @RenderChildren(childLessonGroup);
                        }

                    }

                }


            </div>
        </div>
    </section>
}
else
{


    var childLessons = Model.Children<LessonItem>();


    <!-- start our courses section -->
    <section class="pt-5">
        <div class="container">

            @* <div class="section-heading">
                              <h3>@Model.Title</h3>
                <span class="title-separator mb-3"></span>

                           </div>*@

            <div class="row"> <div class="col"> @Model.HTmlcontent</div></div>

            <div class="row"><span class="title-separator mb-3"></span></div>


            @*@if (Model.ShowSampleVideo)
            {

                <div class="row mt-3 mb-4">

                    <div class="col-12 text-center">
                        <h3>Check out our sample lessons below</h3>
                    </div>

                </div>

                <div class="row mt-3 mb-4">

                    <div class="col-6">
                        <div class="embed-responsive embed-responsive-item embed-responsive-16by9">

                            <iframe src="@Model.SampleVideoUrl" name="azuremediaplayer" scrolling="no" frameborder="no" align="center" height="280px" width="500px" allowfullscreen></iframe>
                        </div>
                    </div>



                    <div class="col-6">
                        <div class="embed-responsive embed-responsive-item embed-responsive-16by9">


                            <iframe src="@Model.SampleVideoUrl2" name="azuremediaplayer" scrolling="no" frameborder="no" align="center" height="280px" width="500px" allowfullscreen></iframe>
                        </div>
                    </div>
                </div>

                <div class="row"><span class="title-separator mb-3"></span></div>
            }*@



            <div class="row">

                @{
                    var childLessonGroups = Model.Children<LessonGroup>();

                    if (childLessonGroups != null && childLessonGroups.Count() > 0)
                    {

                        var courseCounter = 0;

                        foreach (LessonGroup childLessonGroup in childLessonGroups)
                        {

                            var courseColour = "";

                            switch (courseCounter)
                            {

                                case 1:
                                    courseColour = "yellow";
                                    break;
                                case 2:
                                    courseColour = "pink";
                                    break;
                                case 3:
                                    courseColour = "green";
                                    break;
                                case 4:
                                    courseColour = "orange";
                                    break;
                                default:
                                    courseColour = "blue";
                                    break;
                            }




                            <div class="col-md-6 col-lg-6 margin-25px-bottom xs-margin-15px-bottom">
                                <div class="courses-block @courseColour">


                                    @if (childLessonGroup.ParentImage != null)
                                    {
                                        <div class="courses-pic">

                                            <a href="@childLessonGroup.Url()">
                                                <img src="@childLessonGroup.ParentImage.MediaUrl()" alt="@childLessonGroup.Title" />
                                            </a>
                                        </div>
                                    }

                                    <div class="course-desc">
                                        <h4><a href="@childLessonGroup.Url()">@childLessonGroup.Title</a></h4>
                                        @childLessonGroup.ParentSummary
                                    </div>
                                    <div class="course-details">
                                        <ul>
                                            <li>
                                                @childLessonGroup.BottomLeftText
                                            </li>
                                            <li>
                                                @childLessonGroup.BottomRightText
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            courseCounter++;

                            if (courseCounter > 4)
                            {
                                courseCounter = 0;
                            }

                        }

                    }
                    else
                    {

                        if (childLessons != null && childLessons.Count() > 0)
                        {
                            var courseCounter = 0;

                            foreach (LessonItem childLesson in childLessons)
                            {

                                var courseColour = "";

                                switch (courseCounter)
                                {

                                    case 1:
                                        courseColour = "yellow";
                                        break;
                                    case 2:
                                        courseColour = "pink";
                                        break;
                                    case 3:
                                        courseColour = "green";
                                        break;
                                    case 4:
                                        courseColour = "orange";
                                        break;
                                    default:
                                        courseColour = "blue";
                                        break;
                                }





                                <div class="col-md-6 col-lg-6 margin-25px-bottom xs-margin-15px-bottom">
                                    <div class="courses-block @courseColour">
                                      
                                        <div class="course-desc">
                                            <h4><a href="@childLesson.Url()">@childLesson.Title</a></h4>

                                            @if (childLesson.Description.ToHtmlString().Length > 100)
                                            {
                                                @Html.Raw(childLesson.Description.ToHtmlString().Substring(0, 100)) @:...
                                            }
                                            else
                                            {
                                                @childLesson.Description
                                            }


                                        </div>
                                        <div class="course-details">
                                            <ul>
                                                <li>
                                                    @childLesson.BottomLeftText
                                                </li>
                                                <li>
                                                    @childLesson.BottomRightText
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                courseCounter++;

                                if (courseCounter > 4)
                                {
                                    courseCounter = 0;
                                }

                            }

                        }
                    }


                }



            </div>

        </div>
    </section>
    <!-- end our courses section -->
}
