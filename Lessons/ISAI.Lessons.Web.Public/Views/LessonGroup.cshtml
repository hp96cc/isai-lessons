@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.LessonGroup>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";



}


@helper RenderChildren(LessonGroup lessonGroup)
{
    <div class="col-4">

        <h4> @lessonGroup.Title</h4>

        @if (lessonGroup.Children != null && lessonGroup.Children.Count() > 0)
        {

            var childLessons = lessonGroup.Children<LessonItem>
                ();

            if (childLessons != null && childLessons.Count() > 0)
            {

                <ul>

                    @foreach (var childLesson in childLessons)
                    {
                        <li><i class="fas fa-chalkboard-teacher m-2"></i>&nbsp;<u><a href="@childLesson.Url()">@childLesson.Title</a></u></li>
                    }

                </ul>
            }
            else
            {

                var childLessonGroups = lessonGroup.Children<LessonGroup>
                    ();

                foreach (var childLessonGroup in childLessonGroups)
                {
                    @RenderChildren(childLessonGroup);
                }

            }


        }

    </div>


}

<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow  p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()">
    <div class="container">



        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>


                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {


                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }


                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->

@if (Model.ShowLessonsAsList)
{
    <section>
        <div class="container">



            <div class="section-heading mb-2">
                <h3>@Model.Title</h3>

                @Model.HTmlcontent
                <span class="title-separator"></span>
            </div>

            <div class="row no-gutters">



                @{

                    var childLessonGroups = Model.Children<LessonGroup>();

                    if (childLessonGroups != null && childLessonGroups.Count() > 0)
                    {


                        foreach (LessonGroup childLessonGroup in childLessonGroups)
                        {
                            @RenderChildren(childLessonGroup);
                        }

                    }

                }


            </div>
        </div>
    </section>
}
else
{


    var childLessons = Model.Children<LessonItem>();


    <!-- start our courses section -->
    <section>
        <div class="container">

            <div class="section-heading">
                <h3>@Model.Title</h3>

                @Model.HTmlcontent
                <span class="title-separator mb-3"></span>

                @if (Model.ShowSampleVideo)
                {
                    <div class="embed-responsive embed-responsive-item embed-responsive-16by9">
                        <iframe src="@Model.SampleVideoUrl" name="azuremediaplayer" scrolling="no" frameborder="no" align="center" height="280px" width="500px" allowfullscreen></iframe>

                    </div>
                }
            </div>

            <div class="row no-gutters">

                @{
                    var childLessonGroups = Model.Children<LessonGroup>();

                    if (childLessonGroups != null && childLessonGroups.Count() > 0)
                    {

                        var courseCounter = 0;

                        foreach (LessonGroup childLessonGroup in childLessonGroups)
                        {

                            var courseColour = "";

                            switch (courseCounter)
                            {

                                case 1:
                                    courseColour = "yellow";
                                    break;
                                case 2:
                                    courseColour = "pink";
                                    break;
                                case 3:
                                    courseColour = "green";
                                    break;
                                case 4:
                                    courseColour = "orange";
                                    break;
                                default:
                                    courseColour = "blue";
                                    break;
                            }





                            <div class="col-md-6 col-lg-6 margin-25px-bottom xs-margin-15px-bottom">
                                <div class="courses-block @courseColour">
                                    @*<div class="courses-pic">
                                            <a href="course-details.html">
                                                <img src="img/courses/courses-1.jpg" alt="" />
                                            </a>
                                        </div>*@
                                    <div class="course-desc">
                                        <h4><a href="@childLessonGroup.Url()">@childLessonGroup.Title</a></h4>
                                        @childLessonGroup.HTmlcontent
                                    </div>
                                    <div class="course-details">
                                        <ul>
                                            <li>
                                                @childLessonGroup.BottomLeftText
                                            </li>
                                            <li>
                                                @childLessonGroup.BottomRightText
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            courseCounter++;

                            if (courseCounter > 4)
                            {
                                courseCounter = 0;
                            }

                        }

                    }
                    else
                    {

                        if (childLessons != null && childLessons.Count() > 0)
                        {
                            var courseCounter = 0;

                            foreach (LessonItem childLesson in childLessons)
                            {

                                var courseColour = "";

                                switch (courseCounter)
                                {

                                    case 1:
                                        courseColour = "yellow";
                                        break;
                                    case 2:
                                        courseColour = "pink";
                                        break;
                                    case 3:
                                        courseColour = "green";
                                        break;
                                    case 4:
                                        courseColour = "orange";
                                        break;
                                    default:
                                        courseColour = "blue";
                                        break;
                                }





                                <div class="col-md-6 col-lg-6 margin-25px-bottom xs-margin-15px-bottom">
                                    <div class="courses-block @courseColour">
                                        @*<div class="courses-pic">
                                                <a href="course-details.html">
                                                    <img src="img/courses/courses-1.jpg" alt="" />
                                                </a>
                                            </div>*@
                                        <div class="course-desc">
                                            <h4><a href="@childLesson.Url()">@childLesson.Title</a></h4>

                                            @if (childLesson.Description.ToHtmlString().Length > 100)
                                            {
                                                @Html.Raw(childLesson.Description.ToHtmlString().Substring(0, 100)) @:...
                                            }
                                            else
                                            {
                                                @childLesson.Description
                                            }


                                        </div>
                                        <div class="course-details">
                                            <ul>
                                                <li>
                                                    @childLesson.BottomLeftText
                                                </li>
                                                <li>
                                                    @childLesson.BottomRightText
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                courseCounter++;

                                if (courseCounter > 4)
                                {
                                    courseCounter = 0;
                                }

                            }

                        }
                    }


                }



            </div>

        </div>
    </section>
    <!-- end our courses section -->
}
