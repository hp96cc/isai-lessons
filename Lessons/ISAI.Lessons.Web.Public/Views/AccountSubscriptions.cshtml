@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountSubscriptions>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Subscriptions
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">

      

        <div class="row" id="account-nosubscription" style="display:none;">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "subscriptions" } })


            </div>
            <div class="col-9">
                <div class="row">


                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">Subscriptions</h3>
                        <p>You currently have no Subscriptions.</p>

                        <a href="/plans/" class="butn x-small pink  p-2 pl-4 pr-4 ml-4 mb-2 mt-3">Subscribe Now</a>


                    </div>



                </div>
            </div>
        </div>

        <div class="row" id="account-panel" style="display:none;">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "subscriptions" } })


            </div>
            <div class="col-9">
                <div class="row">


                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">Subscriptions</h3>
                        <p>Your current subscription is shown below.</p>


                    </div>


                    <div class="col-12 p-1">
                        <div class="row" id="device-list">

                            <div class="col-12 p-0">
                                <div class="card-body pt-0">

                                    <!-- Info -->
                                    <div class="card card-sm">
                                        <div class="card-body bg-light">
                                            <div class="row">
                                                <div class="col-6">

                                                    <!-- Heading -->
                                                    <h6 class="heading-xxxs text-muted">Subscription Type:</h6>

                                                    <!-- Text -->
                                                    <p class="mb-lg-0 font-size-sm font-weight-bold" id="label-subscription-type">
                                                        TBC
                                                    </p>

                                                </div>
                                                <div class="col-6">

                                                    <!-- Heading -->
                                                    <h6 class="heading-xxxs text-muted">Subscription Status:</h6>

                                                    <!-- Text -->
                                                    <p class="mb-lg-0 font-size-sm font-weight-bold">
                                                        Renews on <span id="label-subscription-expires">12th March 2022</span>
                                                    </p>

                                                </div>


                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <!-- Button -->
                            <div id="div-manual-subscription">
                                <h5 style="color: #ff457e;">To cancel your subscription please email <a style="color: #ff457e;text-decoration:underline;" href="mailto:info@scottishonlinelessons.com">info@scottishonlinelessons.com</a></h5>
                            </div>

                            <button id="button-cancel-subscription" class="butn x-small pink  float-right p-2 pl-4 pr-4 ml-4 mb-2 mt-3" type="button" onclick="PromptCancelSubscription();">Cancel Subscription</button>

                            <button id="button-change-subscription" class="butn x-small sky  float-right p-2 pl-4 pr-4 ml-4 mb-2 mt-3" type="button" onclick="PromptChangeSubscription();">Change Subscription</button>

                            <button id="button-manage-subscription" class="butn x-small sky  float-right p-2 pl-4 pr-4 ml-4 mb-2 mt-3" type="button" onclick="SubscriptionPortal();">Manage Subscription</button>

                            <div id="label-cancelled" class="alert alert-success alert-dismissible fade show mt-4" role="alert" style="display:none;">

                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" id="cancelSubscriptionModal" tabindex="-1" role="dialog" aria-labelledby="cancelSubscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelSubscriptionModallLabel">Cancel Subscription</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you wish to cancel this subscription? You will lose all access to Scottish Online Lessons on <strong><span id="subscription-expiry-date"></span></strong>.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" onclick="CancelSubscription();">Yes</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="changeSubscriptionModal" tabindex="-1" role="dialog" aria-labelledby="changeSubscriptionModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changeSubscriptionModallLabel">Change Subscription</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                You can change to one of the following subscriptions:

                <select id="select-plan" class="form-control">
       
                </select>
                <div class="invalid-feedback">Please choose a plan</div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" onclick="CancelSubscription();">Yes</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {


    <script>

        var subscription;

        $(document).ready(function () {

           GetSubscriptions();

        });

        async function GetSubscriptions() {

            var data = await lessonsApp.subscription();

            //if (!data)
            //{
            //    lessonsApp.logout();
            //}
            if (data.Status !== 0) 
            {
                //TODO: better handle expired or no subscriptions here
                HidePreloader();
                $('#account-nosubscription').show();
            }
            else
            {
                HidePreloader();
                subscription = data.Content;
                DisplaySubscriptions();
            }


        }

        async function SubscriptionPortal() {

            await lessonsApp.subscriptionPortal();

        }

        function DisplaySubscriptions() {

            if (subscription) {

                $('#label-subscription-type').text(subscription.Name);
                $('#label-subscription-expires').text(new Date(subscription.EndDate).toLocaleDateString());
                $('#subscription-expiry-date').text(new Date(subscription.EndDate).toLocaleDateString());

              
                if (subscription.StripeSubscriptionId && subscription.StripeSubscriptionId.startsWith('sub_')) {
                    $('#button-manage-subscription').show();
                    $('#button-manage-subscription').show();
                    $('#div-manual-subscription').hide();
                }
                else {
                    $('#button-manage-subscription').hide();
                    $('#button-manage-subscription').hide();
                    $('#div-manual-subscription').show();
                }


                $('#account-panel').show();

            } else {

                $('#account-nosubscription').show();
            }

        }

        function PromptChangeSubscription()
        {

            switch (subscription.SubscriptionTypeId)
            {






            }


            var availablePlans = "select-plan"


  //            <option value="100">Primary & Secondary Monthly - £22.50 per month</option>
  //<option value="101" selected>Primary & Secondary Annually - £225 per year</option>
  //<option value="102">Primary Monthly - £15 per month</option>
  //<option value="103">Primary Annually - £150 per year</option>
  //<option value="104">Secondary Monthly - £15 per month</option>
  //<option value="105">Secondary Annually - £150 per year</option>

            availablePlans.forEach(x => $("#select-plan").append(new Option(x.Name, x.Id)))

            $('#changeSubscriptionModal').modal('show')
        }


        function PromptCancelSubscription()
        {
            $('#cancelSubscriptionModal').modal('show')
        }
        
        async function CancelSubscription() {

            var data = await lessonsApp.cancelStripeSubscription();

            //TODO: need to handle
            HidePreloader();
            DisplaySubscriptions();
          
        }
        


    </script>




}
