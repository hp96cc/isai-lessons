            <span class="title-separator"></span>
        </div>
        <div class="row">
            <div class="col-lg-6 col-12 md-margin-30px-bottom">
                <div class="pricing-block-2 padding-40px-lr padding-40px-top padding-50px-bottom md-padding-25px-all text-center border-radius-10">
                    <h4 class="margin-5px-bottom font-weight-600">Primary Lessons</h4>
                    <p class="margin-10px-bottom md-margin-10px-bottom sm-margin-10px-bottom"></p>
                    <div class="pricing-price bg-purple">
                        <div class="text-white font-size40 md-font-size38 sm-font-size36 xs-font-size34 no-margin-bottom">&pound;<span class="padding-10px-left sm-padding-5px-left">5</span></div>
                    </div>
                    <p class="margin-10px-top md-margin-10px-top sm-margin-10px-top">per month billed monthly <br />(or £50 billed annually)</p>

                    <ul class="list-style9 margin-35px-tb md-margin-30px-tb sm-margin-25px-tb">
                        <li>All Scottish Primary Lessons</li>
                        <li>Up to 2 devices</li>
                        @*<li>Feature 3</li>
                        <li>Feature 4</li>*@
                    </ul>
                    
                      <h3 class="purple p-2 pl-4 pr-4 mb-2 mt-2" style="cursor:none;">Available 1st June 2021</h3>
                   @* <a href="/plans/signup/?planId=1" class="butn purple small  p-2 pl-4 pr-4 mb-2 mt-2">Signup Now</a> *@
                </div>
            </div>
            <div class="col-lg-6 col-12 md-margin-30px-bottom">
                <div class="pricing-block-2 padding-40px-lr padding-40px-top padding-50px-bottom md-padding-25px-all text-center border-radius-10">
