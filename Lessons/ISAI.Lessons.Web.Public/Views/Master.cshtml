@inherits Umbraco.Web.Mvc.UmbracoViewPage
@{
    Layout = null;

    ViewBag.LoggedIn = false;

    /* Check is logged in */
    if (Request.Cookies["lessons_access_token"] != null && Request.Cookies["lessons_access_token"].Value.ToString().Length > 100)
    {
        ViewBag.LoggedIn = true;
    }


    var home = Model.Root() as Home;

    string metaTitle = home.Name;

    if (home.Name != Model.Name)
    {
        metaTitle += " - " + Model.Name;
    }

    string metaDescription = null;

    var seoModel = Model as ISEO;

    if (seoModel != null)
    {

        if (!string.IsNullOrWhiteSpace(seoModel.MEtatitle))
        {
            metaTitle = seoModel.MEtatitle;
        }

        if (!string.IsNullOrWhiteSpace(seoModel.MEtadescription))
        {
            metaDescription = seoModel.MEtadescription;
        }

    }


    var canonicalUrl = "https://" + Request.ServerVariables["HTTP_HOST"] + Model.Url();
    metaTitle = "Scottish " + metaTitle;



}


@helper RenderMenuItem(IPublishedContent page, int menudepth)
{

    var lessonGroup = page as LessonGroup;

    var lessonGroups = page.Children<LessonGroup>();
    var lessons = page.Children<LessonItem>();



    if (lessonGroup != null && menudepth <= 1)
    {

        <li>
            <a href="@lessonGroup.Url()">@lessonGroup.Name</a>

            @if (lessonGroups != null && lessonGroups.Count() > 0)
            {

                if (menudepth < 1)
                {

                    <ul>
                        @foreach (var newlessonGroup in lessonGroups)
                        {

                            @RenderMenuItem(newlessonGroup, menudepth + 1);
                        }
                    </ul>

                }
            }
            else if (lessons != null && lessons.Count() > 0)
            {
                <ul>

                    @foreach (var lesson in lessons)
                    {

                        <li><a href="@lesson.Url()">@lesson.Name</a></li>
                    }

                </ul>
            }


        </li>

    }


}


