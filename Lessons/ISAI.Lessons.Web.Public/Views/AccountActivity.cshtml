@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountActivity>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Activity
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">

        <div class="row">
            <div class="col-12 text-center">
                <div class="spinner-border mb-10" role="status" id="spinner-loading">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        </div>

        <div class="row" id="account-panel" style="display:none;">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "activity" } })


            </div>
            <div class="col-9">
                <div class="row">


                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">Activity</h3>
                        <p>The table below shows your viewing history</p>



                    </div>


                    <div class="col-12 p-1">
                        <div class="row" id="activity-list"></div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>




@section Scripts {

    <template id="template-activity">

        <div class="col-12 p-0">
            <div class="card-body pt-0">

                <!-- Info -->
                <div class="card card-sm">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-6">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">
                                    Lesson: {{LessonName}}
                                </h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm ">
                                    {{LessonGroupName}}
                                </p>

                            </div>
                            <div class="col-6">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">Date / Time Watched:</h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm font-weight-bold">
                                    <time datetime="{{DateTimeWatched}}">
                                        {{DateTimeWatched}}
                                    </time>
                                </p>

                            </div>


                        </div>
                        <div class="row">
                            <div class="col-10 mt-2">

                                <div class="row">
                                    <div class="col-10 mt-2">

                                        <a href="/api/lessonumbraco/{{LessonId}}" class="butn x-small green p-2 pl-3 pr-3 mb-2"><span>Watch Again</span></a>


                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </div>


    </template>


    <script>

        var activity = [];

        $(document).ready(function () {

            GetActivity();

        });


        async function GetActivity() {

            $('#account-panel').hide();
            $('#spinner-loading').show();

            var request = {
                Page: 0,
                RecordCount: 20
            };

            var data = await lessonsApp.customerActivity(request);

            if (!data)
            {
                //lessonsApp.logout();
            }
            else if (data.Status !== 0)
            {
                //location.href = '/account/'
            } else
            {
                activity = data.Content.LessonHistory;
                DisplayActivity();
            }

        }

        function DisplayActivity() {

            $('#activity-list').html('');

            var itemListHTML = '';
            var templateItem = $('#template-activity').html();

            activity.forEach(function (item) {

                itemListHTML += Mustache.render(templateItem, item);

            });


            $('#activity-list').html(itemListHTML);

            $('#account-panel').show();
            $('#spinner-loading').hide();


        }



    </script>




}
