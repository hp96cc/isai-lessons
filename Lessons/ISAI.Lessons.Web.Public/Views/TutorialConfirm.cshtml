@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.TutorialConfirm>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
    var sessionId = Request.QueryString["session_id"];
    var tutorStripeId = Request.QueryString["tutorStripeId"];
}

<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="/media/1f3fd5lm/blue-header-background.png" style="background-image: url(/media/1f3fd5lm/blue-header-background.png);">
    <div class="container">
        <div class="page-title">
            <h1>Tutorial Signup Confirmation</h1>
            <p><strong>Your tutor session is confirmed.</strong></p>
        </div>
    </div>
</section>

<section class="pt-2">
    <div class="container">

        <div class="row justify-content-center mt-3" id="account-grouptutorial">
            <div class="col-6">

                <h3>Tutorial Signup Confirmation</h3>
                <p>
                    Congratulations, a tutorial session has been booked as follows:
                </p>

                <table class="table table-striped">

                    <tr>
                        <td>Date:</td>
                        <td><strong id="tutorial-date"></strong></td>
                    </tr>
                    <tr>
                        <td>Time:</td>
                        <td><strong id="tutorial-starttime">00:00</strong> to <strong id="tutorial-endtime">00:00</strong></td>
                    </tr>
                    <tr>
                        <td>Duration:</td>
                        <td><strong><span id="tutorial-duration"></span></strong></td>
                    </tr>
                    <tr>
                        <td>Cost:</td>
                        <td><strong><span id="tutorial-cost"></span></strong></td>
                    </tr>
                </table>


                <p>Please make sure you have joined your session 10 minutes before to get your notes ready.</p>
                <p>For more information on how to join a tutorial <a class="textlink" target="_blank" href="/faqs/">click here</a></p>


                <p>If you have any issues, please contact <a class="textlink" href="mailto:info@scottishonlinelessons.com">info@scottishonlinelessons.com</a></p>

                <a type="button" class="butn x-small green p-2 pl-3 pr-3 mb-2" href="/account/tutorials">View My Tutorials</a>



            </div>
            </div>



        </div>


</section>



@section Scripts {

    <script>

        const optionsDate = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
        const optionsTime = { hour12: false, hour: '2-digit', minute: '2-digit' };
        var tutorial;

        $(document).ready(function ()
        {
            GetTutorial();

        });

        async function GetTutorial()
        {

            ShowPreloader();

            var request = {
                StripeSessionId: '@sessionId',
                TutorStripeId: @(Html.Raw(string.IsNullOrWhiteSpace(tutorStripeId) ? "null" : "'" + tutorStripeId + "'"))
            }

            var data = await lessonsApp.tutorial(request);

            //TODO: need to handle an error here
            if (!data)
            {
                //lessonsApp.logout('/account/tutorials');
            }
            else if (data.Status !== 0)
            {
                //location.href = '/account/tutorials';
            }
            else
            {
                tutorial = data.Content;
                DisplayTutorial();
            }


        }

        async function DisplayTutorial()
        {

            $('#tutorial-date').text(new Date(tutorial.DateTimeStart).toLocaleDateString('en-GB', optionsDate));
            $('#tutorial-starttime').text(new Date(tutorial.DateTimeStart).toLocaleTimeString('en-GB', optionsTime));
            $('#tutorial-endtime').text(new Date(tutorial.DateTimeEnd).toLocaleTimeString('en-GB', optionsTime));
            $('#tutorial-duration').text(tutorial.DurationInMinutes + ' minutes');
            $('#tutorial-cost').text('£' + tutorial.TutorialCost);

            HidePreloader();


        }


    </script>
}