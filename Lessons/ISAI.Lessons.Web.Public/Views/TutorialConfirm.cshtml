@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.TutorialConfirm>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}

<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="/media/1f3fd5lm/blue-header-background.png" style="background-image: url(/media/1f3fd5lm/blue-header-background.png);">
    <div class="container">
        <div class="page-title">
            <h1>Congratulations</h1>
            <p><strong>Your tutor session is confurmed.</strong></p>
        </div>
    </div>
</section>

<section class="pt-2">
    <div class="container">
        <div class="section-heading">

            <span class="title-separator"></span>
        </div>
        <div class="row">
            <div class="col text-center h3">

                <p>Hi,</p>
                <p>A tutorial session has been booked as follows:</p>
                <p><strong>Date: {{Date}}</strong><br /><strong>Time: {{Time}}</strong><br /><strong>Duration: {{Duration}}</strong><br /><strong>Cost: {{Cost}}</strong><br /><br /></p>
                <p>Please make sure you have joined your session 10 minutes before to get your notes ready.</p>
                <p>If you don’t have a Microsoft account, Download the app <u>here</u>. <strong>(this needs work, its doesn't make sense - craig)</strong></p>
                <p>Well done! Lets get learning. 💪</p>
                <p><br />Thanks<br /><br />Scottish Online Lessons Team</p>

                <p>If you have any issues, please contact <a href="mailto:info@scottishonlinelessons.com">info@scottishonlinelessons.com</a></p>

            </div>
        </div>
    </div>
</section>

@section Scripts {

    <script>

        $(document).ready(function ()
        {
            HidePreloader();

        });

    </script>
}