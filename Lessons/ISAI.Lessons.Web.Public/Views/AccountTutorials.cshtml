@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.AccountTutorials>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<!-- BREADCRUMB -->
<nav class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <!-- Breadcrumb -->
                <ol class="breadcrumb mb-0 font-size-xs text-gray-400">
                    <li class="breadcrumb-item">
                        <a class="text-gray-400" href="index.html">Home</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Tutorials
                    </li>
                </ol>



            </div>
        </div>
    </div>
</nav>

<!-- CONTENT -->
<section class="p-0">
    <div class="container">

       

        <div class="row" id="account-panel">
            <div class="col-3">

                <!-- Nav -->
                @Html.Partial("Partials/_AccountMenu", new ViewDataDictionary { { "active-menu", "tutorials" } })


            </div>
            <div class="col-9">
                <div class="row">

                    <div class="col-12 text-right">
                        <a href="/tutorials/calendar/" class="butn x-small pink float-right p-2 pl-3 pr-3 mb-2"><span>New Tutorial</span></a>

                    </div>
                    <div class="col-12">

                        <!-- Heading -->
                        <h3 class="mb-10">My Tutorials</h3>
                        <p>Below is a list of all of your booked lessons. You can join your lessons from here by selecting JOIN TUTORIAL, which will take you straight to your Microsoft Teams call. If you enjoyed a previous lesson, you can re-book the exact same lesson by clicking on the RE-BOOK TUTORIAL button on a previous session.</p>



                    </div>


                    <div class="col-12 p-1">
                        <div class="row" id="tutorial-list"></div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <template id="template-tutorial">

        <div class="col-12 p-0">
            <div class="card-body pt-0">

                <!-- Info -->
                <div class="card card-sm">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-10">

                                <!-- Heading -->
                                <h6 class="heading-xxxs text-muted">{{Date}} @@ {{TimeStart}} to {{TimeEnd}}</h6>

                                <!-- Text -->
                                <p class="mb-lg-0 font-size-sm font-weight-bold">
                                    {{Name}}
                                </p>


                            </div>
                            <div class="col-2 float-right">

                                {{#IsCompleted}}
                                <!-- Button -->
                                <button class="btn btn-circle float-right p-0" data-toggle="modal" data-target="#deleteDeviceModal" onclick="alert('TODO: What are the terms to delete a tutorial?')">
                                    <i class="far fa-trash-alt delete-button"></i>
                                </button>
                                {{/IsCompleted}}

                            </div>


                        </div>
                        <div class="row">
                            <div class="col-10 mt-2">

                                {{#IsCompleted}}
                                <a href="{{TeamsLink}}" target="_blank" class="butn x-small green p-2 pl-3 pr-3 mb-2"><span>Join Tutorial</span></a>

                                {{/IsCompleted}}
                                {{^IsCompleted}}
                                <a href="/tutorials/calendar/?rebookId={{Id}}" class="butn x-small pink p-2 pl-3 pr-3 mb-2"><span>Re-Book Tutorial</span></a>

                                {{/IsCompleted}}


                            </div>
                    
                        </div>

                    </div>

        </div>


    </template>

    <script>

        var tutorials = [];

        $(document).ready(function ()
        {
            GetTutorials();
        });


        async function GetTutorials()
        {

            var data = await lessonsApp.tutorials();

            if (!data)
            {
               lessonsApp.logout();
            }
            else if (data.Status !== 0)
            {
                location.href = '/account/'
            }
            else
            {
                HidePreloader();
                tutorials = data.Content.Tutorials;
                DisplayTutorials();
            }


        }

        async function DisplayTutorials()
        {

            $('#tutorial-list').html('');

            var itemListHTML = '';
            var templateItem = $('#template-tutorial').html();

            tutorials.forEach(function (item)
            {
                itemListHTML += Mustache.render(templateItem, item);

            });


            $('#tutorial-list').html(itemListHTML);

            $('#account-panel').show();
            $('#spinner-loading').hide();


        }

    </script>
}

