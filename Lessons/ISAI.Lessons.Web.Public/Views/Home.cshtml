                                    "ease":"Power3.easeInOut"
                                }]'>
                                <p class="white-space">@scrollerItem.Title</p>
                            </div>

                            <!-- HERO TITLE -->
                            <div class="tp-caption font-weight-800 text-sky alt-font text-right xs-text-center" style="color:#3b18ff;" data-x="['right','right','right','center']" data-y="center" data-voffset="[-65,-45,-55,-35]" data-fontsize="[48,36,30,24]" data-lineheight="[58,46,40,34]" data-hoffset="['30','30','30','0']" data-width="[700, 650, 400, 350]" data-whitespace="normal" data-frames='[{
                                    "delay":0,
                                    "speed":2000,
                                    "frame":"0",
                                    "from":"x:[-175%];y:0px;z:0;rX:0;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;opacity:1;",
                                    "mask":"x:[100%];y:0;s:inherit;e:inherit;",
                                    "to":"o:1;",
                                    "ease":"Power3.easeOut"
                                    },{
                                    "delay":"wait",
                                    "speed":300,
                                    "frame":"999",
                                    "to":"auto:auto;",
                                    "ease":"Power3.easeInOut"
                                }]' data-splitout="none">
                                @scrollerItem.SubTitle
                            </div>

                            <!-- BUTTON -->
                            <div class="tp-caption" data-x="['right','right','right','center']" data-y="center" data-voffset="[80,100,60,65]" data-lineheight="55" data-hoffset="['30','30','30','0']" data-frames='[{
                                        "delay":600,
                                        "speed":1300,
                                        "frame":"0",
                                        "from":"y:150px;opacity:0;",
                                        "ease":"Power3.easeOut",
                                        "to":"o:1;"
                                        },{
                                        "delay":"wait",
                                        "speed":1000,
                                        "frame":"999",
                                        "to":"opacity:0;","ease":"Power3.easeOut"
                                    }]'>
                                <a href='@scrollerItem.ButtonLink.Url()' class='butn yellow'><span>@scrollerItem.ButtonText</span></a>
                            </div>
                        }




                    </li>

                    scrollerCounter++;

                    if (scrollerCounter > 2)
                    {
                        scrollerCounter = 0;
                    }
                }


            }



        </ul>
    </div>
</div>
<!-- end revolution slideshow-->
<!-- start features section -->
<section>
    <div class="container margin-15px-top">
        <div class="row">

            @{

                var boxCounter = 0;

                foreach (var contentBox in Model.ContextBoxes)
                {

                    var boxColour = "blue";

                    switch (boxCounter)
                    {

                        case 1:
                            boxColour = "pink";
                            break;
                        case 2:
                            boxColour = "green";
                            break;
                        case 3:
                            boxColour = "orange";
                            break;
                        default:
                            boxColour = "yellow";
                            break;
                    }

                    <div class="col-sm-6 col-lg-6 sm-margin-30px-bottom ms-margin-25px-bottom">
                        <div class="features-block @boxColour">

                            <h4>
                                @contentBox.Title
                            </h4>
                            <p>@contentBox.Text</p>
                            <br />


                            <a href="@contentBox.Link.Url()" class="butn small @boxColour m-2 p-3"><span>@contentBox.ButtonText</span></a>

                        </div>
                    </div>

                    boxCounter++;

                    if (boxCounter > 3)
                    {
                        boxCounter = 0;
                    }


                }


            }


        </div>
    </div>
</section>
<!-- end features section -->
