<!-- start about section -->
<section class="parallax no-padding-bottom background-position-center-center" data-background="@Model.BackgroundImage.MediaUrl()">
    <div class="container padding-90px-top md-padding-70px-top sm-padding-50px-top xs-padding-15px-top">

        <div class="row">
            <div class="col-md-9 col-lg-8 col-xl-7">
                <div class="about-detail">
                    <div class="section-heading left">
                        <h2>@Model.Title</h2>
                        <span class="title-separator"></span>
                    </div>
                    @Model.Text
                    <a href="@Model.ButtonLink.Url()" class="butn small margin-15px-top xs-margin-5px-top p-3">@Model.ButtonText</a>
                </div>
            </div>
        </div>

    </div>

</section>
<!-- end about section -->

@if (Model.ShowReviewTab)
{

    <!-- start testimonial section -->
    <section class="testimonial-section pt-5">
        <div class="container">
            <div class="section-heading">
                <h3>@Model.ReviewTitle</h3>
                <div class="title-separator"></div>

            </div>
            @if (Model.Reviews != null)
            {

                <div class="owl-carousel owl-theme">


                    @foreach (var review in Model.Reviews)
                    {
                        <div class="testimonial-single">
                            <div class="content">
                                <p class="no-margin-bottom">@review.ReviewText</p>
                            </div>
                            <div class="info-box">
                                <div class="d-flex align-items-center">
                                    @*<div>
                                            <img src="/assets/img/parents/1.jpg" alt="" class="rounded-circle" />
                                        </div>*@
                                    <div class="">
                                        <h5>@review.ReviewerName</h5>
                                        <h6 class="opacity4 main-font">@review.ReviewDate.ToString("dd/MM/yyyy")</h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }



                </div>

            }
            else
            {
                <p>No Reviews </p>


            }

        </div>
    </section>
    <!-- end testimonial section -->

}


