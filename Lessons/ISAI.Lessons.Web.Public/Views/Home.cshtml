                                        "frame":"0",
                                        "from":"y:150px;opacity:0;",
                                        "ease":"Power3.easeOut",
                                        "to":"o:1;"
                                        },{
                                        "delay":"wait",
                                        "speed":1000,
                                        "frame":"999",
                                        "to":"opacity:0;","ease":"Power4.easeOut"
                                    }]'>
                                <a href='@scrollerItem.ButtonLink.Url()' class='butn yellow'><span>@scrollerItem.ButtonText</span></a>
                            </div>
