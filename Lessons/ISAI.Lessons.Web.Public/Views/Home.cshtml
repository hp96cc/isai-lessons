                            <div class="tp-caption text-pink alt-font font-weight-700 text-right xs-text-center" data-x="['right','right','right','center']" data-y="[center]" data-voffset="[-180,-150,-150,-120]" data-fontsize="[32,30,32,28]" data-lineheight="34" data-hoffset="['30','30','30','0']" data-width="[700,650,400,350]" data-whitespace="normal" data-frames='[{
                                    "delay":0,
