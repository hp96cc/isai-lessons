        <div class="section-heading">

            <span class="title-separator"></span>
        </div>
        <div class="row">
            <div class="col text-center h3">

                <p>Please contact <a href="mailto:info@scottishonlinelessons.com">info@scottishonlinelessons.com</a> for further assistance</p>

            </div>
