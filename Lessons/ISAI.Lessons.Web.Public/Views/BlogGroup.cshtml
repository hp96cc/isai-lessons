@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.BlogGroup>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
	Layout = "Master.cshtml";
	var blogItems = Model.Children<BlogItem>();
}


	<!-- start page title section -->
	<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()">
		<div class="container">
			<div class="page-title">
				<h1>@Model.Title</h1>
				<div class="page-link">
					<ul>
						<li><a href="/">Home</a></li>
						<li><a href="javascript:void(0)">@Model.Title</a></li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<!-- end page title section -->
	<!-- start blog grid section -->
	<section class="pt-3">
		<div class="container lg-container">
            <div class="row">

                @Model.PageContent

                @if (blogItems != null && blogItems.Count() > 0)
                {

                    var courseCounter = -1;

                    foreach (var blogItem in blogItems)
                    {

                        var courseColour = "";
                        courseCounter++;

                        switch (courseCounter)
                        {

                            case 1:
                                courseColour = "yellow";
                                break;
                            case 2:
                                courseColour = "pink";
                                break;
                            case 3:
                                courseColour = "green";
                                break;
                            case 4:
                                courseColour = "orange";
                                break;
                            default:
                                courseColour = "sky";
                                break;
                        }

                        <div class="col-lg-4 col-md-6 margin-40px-bottom sm-margin-30px-bottom">
                            <div class="news-block @courseColour">
                                <div class="news-img">
                                    <a href="blog-post.html"><img src="@blogItem.BlogImage.MediaUrl()" alt="@blogItem.Title" /></a>
                                    <div class="date-details">
                                        <span class="date">@blogItem.BlogDate.Day</span>
                                        <p class="month">@blogItem.BlogDate.ToString("MMM")</p>
                                    </div>
                                </div>
                                <div class="news-details">
                                    <ul class="blog-deta">
                                        <li>
                                            <a href="@blogItem.Url()"><i aria-hidden="true" class="fa fa-user"></i> @blogItem.BlogAuthor</a>
                                        </li>
                                        @*<li>
                                    <a href="blog-post.html"><i aria-hidden="true" class="fas fa-comments"></i> 4 Comments</a>
                                </li>*@
                                    </ul>
                                    <h4><a href="@blogItem.Url()">@blogItem.Title</a></h4>
                                    @blogItem.BlogSummary
                                    <a href="@blogItem.Url()">read more ...</a>
                                </div>
                            </div>
                        </div>

                     
                    }
                }



            </div>

			<!--<div class="row">
				<div class="col-sm-12">-->
					<!-- start pager  -->
					<!--<div class="text-center margin-60px-top md-margin-50px-top sm-margin-40px-top">
						<div class="pagination text-small text-extra-dark-gray">
							<ul>
								<li><a href="javascript:void(0);"><i class="fas fa-long-arrow-alt-left margin-5px-right xs-display-none"></i> Prev</a></li>
								<li class="active"><a href="javascript:void(0);">1</a></li>
								<li><a href="javascript:void(0);">2</a></li>
								<li><a href="javascript:void(0);">3</a></li>
								<li><a href="javascript:void(0);">Next <i class="fas fa-long-arrow-alt-right margin-5px-left xs-display-none"></i></a></li>
							</ul>
						</div>
					</div>-->
					<!-- end pager -->
				<!--</div>
			</div>-->

		</div>
	</section>
	<!-- end blog grid section -->
