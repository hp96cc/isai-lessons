@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.SignUpEnterDetails>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";


    /* Redirect if logged */
    if (Request.Cookies["lessons_access_token"] != null && Request.Cookies["lessons_access_token"].Value.ToString().Length > 100)
    {
        Response.Redirect("/account/info");
    }

    string redirectUrl = null;

    if (Request.QueryString["redirectUrl"] != null)
    {
        redirectUrl = Request.QueryString["redirectUrl"].ToString();
    }

    var isGroupTutorial = redirectUrl != null && redirectUrl.Contains("groupTutorialId");

    var isStripeTest = (Request.ServerVariables["HTTP_HOST"].ToLower().Contains("localhost")
        ||
        Request.ServerVariables["HTTP_HOST"].ToLower().Contains("test")) ? true : false;

    var canonicalUrl = "https://" + Request.ServerVariables["HTTP_HOST"] + Model.Url();

}


<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0" data-background="@Model.BackgroundImage.MediaUrl()" style="background-image: url(@Model.BackgroundImage.MediaUrl());">
    <div class="container">
        <div class="page-title">
            <h1>Signup</h1>
            <p><strong>To sign up for a Scottish Online Lessons account please complete the details below.</strong></p>
        </div>
    </div>
</section> 


<section class="pt-5">

    <div class="container">
   
        <div class="row">
            <div class="col-lg-8 col-md-10 center-col">

                <div class="block-info">

                    <h6 class="bg-sky">Signup</h6>

                    <div class="padding-50px-all md-padding-50px-all sm-padding-25px-all">

                        <div class="spinner-border  mb-10" role="status" id="spinner-loading" style="display:none;">
                            <span class="sr-only">Loading...</span>
                        </div>

                        <form method="post" id="register-form" class="needs-validation" novalidate>

                            <div class="row">

                           

                                <div id="section-confirmgrouptutorial" style="display:none;">

                                   

                                   

                                </div>


                                <div id="section-chooseplan" style="display:none;">
                                    <div class="col-12">

                                        <div class="alert alert-success" role="alert">
                                            To access your Free Trial please fill in the below contact form with your details and select ’I have an access code’. In this section please enter 'FREE1DAYTRIAL'
                                        </div>


                                    </div>
                                    <div class="col-12">

                                        <h5>Choose your plan:</h5>


                                    </div>

                                    <div class="col-12" id="div-input-chooseplan">
                                        <div class="form-group">
                                            <label>Choose Plan: *</label>

                                            <select id="select-plan" class="form-control" required>
                                                <option value="100">Primary & Secondary Monthly - £22.50 per month</option>
                                                <option value="101" selected>Primary & Secondary Annually - £225 per year</option>
                                                <option value="102">Primary Monthly - £15 per month</option>
                                                <option value="103">Primary Annually - £150 per year</option>
                                                <option value="104">Secondary Monthly - £15 per month</option>
                                                <option value="105">Secondary Annually - £150 per year</option>
                                            </select>
                                            <div class="invalid-feedback">Please choose a plan</div>
                                        </div>
                                    </div>

                                    <div class="col-md-12" id="div-input-accesscode" style="display:none;">
                                        <div class="form-group">
                                            <label>Access Code *:</label>
                                            <input type="text" class="form-control" id="input-accesscode" name="input-accesscode" autocomplete="none" />
                                            <div class="invalid-feedback">Access code is required</div>
                                        </div>
                                    </div>


                                    <div class="col-md-12" id="div-input-toggleaccesscode">
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox">
                                                <input type="checkbox" class="custom-control-input" id="checkbox-accesscode" onchange="ToggleAccessCode();">
                                                <label class="custom-control-label" for="checkbox-accesscode">I have an access code (For free one day trial input 'FREEONEDAYTRIAL')</label>
                                                <span class="invalid-feedback">Access code invalid.</span>

                                            </div>
                                        </div>
                                    </div>



                                </div>

                          


                                <div class="col-12 mt-4">

                                    <h5>Your Details:</h5>


                                </div>

                                <div class="col-md-6">

                                    <div class="form-group">
                                        <label>Firstname *:</label>
                                        <input type="text" class="form-control" id="input-firstname" name="input-firstname" placeholder="First Name" autocomplete="none" required />
                                        <div class="invalid-feedback">Firstname is required</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Surname *:</label>
                                        <input type="text" class="form-control" id="input-lastname" name="input-lastname" placeholder="Surname" autocomplete="none" required />
                                        <div class="invalid-feedback">Surname is required</div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Email *:</label>
                                        <input type="email" class="form-control" id="input-email" name="input-email" placeholder="name@email.com" autocomplete="none" required />
                                        <div class="invalid-feedback">Email is required</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Password *:</label>
                                        <input type="password" class="form-control" id="input-password" name="input-password" placeholder="Password" autocomplete="new-password" required />
                                        <div class="invalid-feedback">Password is required</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Confirm Password *:</label>
                                        <input type="password" class="form-control" id="input-confirmpassword" name="input-confirmpassword" placeholder="Confirm Password" autocomplete="new-password" required />
                                        <div class="invalid-feedback">Confirm Password is required</div>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>How did you hear about us?</label>
                                        <input type="text" class="form-control" id="input-hearabout" placeholder="e.g. TikTok, Snapchat, Google, Facebook. " name="input-hearabout" autocomplete="none" />

                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="input-newsletter">
                                        <label class="custom-control-label" for="input-newsletter">Accept emails for updates and offers?</label>
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="input-terms-condition" required>
                                        <label class="custom-control-label" for="input-terms-condition">I agree to the <a href="https://www.scottishonlinelessons.com/terms/" target="_blank">Terms &amp; Conditions</a></label>
                                        <span class="invalid-feedback">You must agree before submitting.</span>

                                    </div>
                                </div>


                                <div class="col-md-12" id="div-input-autorenewal" style="display:none;">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="checkbox-autorenewal" required>
                                        <label class="custom-control-label" for="checkbox-autorenewal">I am aware this will automatically renewal monthly until I cancel it</label>
                                        <span class="invalid-feedback">You must agree before submitting..</span>

                                    </div>
                                </div>




                                <div id="form-error-label" class="col-md-12 alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">

                                </div>



                                <div class="col-md-12 margin-35px-top sm-margin-25px-top">
                                    <button type="button" id="button-signup" style="display:none;" onclick="Signup();" class="butn yellow small btn-block p-2 pl-4 pr-4 mb-2 mt-2">Signup</button>
                                    <button type="button" id="button-checkout" style="display:none;" onclick="GoToPayment();" class="butn yellow small btn-block p-2 pl-4 pr-4 mb-2 mt-2">Go To Payment</button>
                                    <button type="button" id="button-activate" style="display:none;" onclick="Activate();" class="butn yellow small btn-block p-2 pl-4 pr-4 mb-2 mt-2">Activate Access Code</button>

                                </div>

                                <div class="col-md-12 text-center margin-25px-top">
                                    <span>Already have an account? <a href="/account">Login</a></span>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section Head {

    <script src="https://js.stripe.com/v3/"></script>

}


@section Scripts {
    
    <script>

        var loggedIn = false;
        var isGroupTutorial = @(isGroupTutorial ? "true;" : "false;")

        @if(ViewBag.LoggedIn != null)
        {
            @:loggedIn = true
        }

        $(document).ready(function () {

            if (loggedIn)
            {
                location.href = '/account/';
            } else {
                $('#register-form').show();

            }

            if (isGroupTutorial)
            {
                $('#section-confirmgrouptutorial').show();
                $('#section-chooseplan').hide();
                $('#div-input-toggleaccesscode').hide();
                $('#button-checkout').hide();
                $('#button-signup').show();
                $('#div-input-autorenewal').hide();
                $('#checkbox-autorenewal').removeAttr('required');
            }
            else
            {
                $('#section-confirmgrouptutorial').hide();
                $('#section-chooseplan').show();
                $('#div-input-toggleaccesscode').show();
                $('#button-checkout').show();
                $('#button-signup').hide();
                $('#div-input-autorenewal').show();
            }

        });


        function ToggleAccessCode() {

            var isAccessCodeChecked = $("#checkbox-accesscode").is(':checked');

            if (isAccessCodeChecked) {

                $("#button-checkout").hide();
                $("#div-input-chooseplan").hide();
                $("#button-activate").show();
                $("#div-input-accesscode").show();
                $('#input-accesscode').attr('required', 'required');


            } else {

                $('#input-accesscode').removeAttr('required');
                $("#button-checkout").show();
                $("#div-input-chooseplan").show();
                $("#button-activate").hide();
                $("#div-input-accesscode").hide();

            }

        }

        async function Activate() {

            $('#form-error-label').text('');
            $('#form-error-label').hide();

            var form = document.getElementById("register-form");

            if (form.checkValidity() === false) {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else {

                $('#register-form').hide();
                $('#spinner-loading').show();
                var errorHTML = '';

                var registerRequestViewModel = {

                    firstName: $("#input-firstname").val().trim(),
                    lastName: $("#input-lastname").val().trim(),
                    email: $("#input-email").val().trim(),
                    password: $("#input-password").val().trim(),
                    passwordConfirm: $('#input-confirmpassword').val().trim(),
                    acceptMarketing: $('#input-newsletter').prop("checked"),
                    accessCode: $('#input-accesscode').val(),
                    hearAbout: $('#input-hearabout').val()

                }

                var data = await lessonsApp.signupWithAccessCode(registerRequestViewModel);

                if (data.Status === 0) {

                    window.location.href = '/plans/confirmed';
                    return;

                } else {

                    if (data.ErrorResponse !== null && data.ErrorResponse.length > 0) {

                        errorHTML += '<ul>';

                        data.ErrorResponse.forEach(function (item) {
                            errorHTML += '<li>' + item.Message + '</li>';
                        });

                        errorHTML += '</ul>';
                    }
                    else if (data.Errors.length === 1) {
                        errorHTML = data.ErrorResponse[0].Message;
                    }
                    else {
                        errorHTML = 'Could not activate account. Please contact support';
                    }

                }

                $('#form-error-label').html(errorHTML);
                $('#form-error-label').show();
                $('#register-form').show();
                $('#spinner-loading').hide();

            }
        }

        async function Signup()
        {
            $('#form-error-label').text('');
            $('#form-error-label').hide();

            var form = document.getElementById("register-form");

            if (loggedIn == false && form.checkValidity() === false)
            {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else
            {


                $('#register-form').hide();
                $('#spinner-loading').show();
                var errorHTML = '';

                var registerObject = {

                    firstName: $("#input-firstname").val(),
                    lastName: $("#input-lastname").val(),
                    email: $("#input-email").val(),
                    password: $("#input-password").val(),
                    passwordConfirm: $('#input-confirmpassword').val(),
                    acceptMarketing: $('#input-newsletter').prop("checked"),
                    hearAbout: $('#input-hearabout').val()
                }

                var data = await lessonsApp.register(registerObject);

                if (data && data.Content != null)
                {

                      @if(string.IsNullOrWhiteSpace(redirectUrl))
                      {
                          @:location.href = "/account/info";
                      }
                      else
                      {
                          @:location.href = "@redirectUrl";
                      }
                    return;


                }
                else
                {

                    errorHTML = 'Could not create account. Please contact support';
                }

                $('#form-error-label').html(errorHTML);
                $('#form-error-label').show();
                $('#register-form').show();
                $('#spinner-loading').hide();

            }
        }

        async function GoToPayment()
        {

            $('#form-error-label').text('');
            $('#form-error-label').hide();

            var form = document.getElementById("register-form");

            if (loggedIn == false && form.checkValidity() === false)
            {

                event.preventDefault();
                event.stopPropagation();
                form.classList.add('was-validated');

            } else
            {

                if (/^\s*$/.test($('#input-subscriptiontypeid').val()))
                {
                    $('#form-error-label').html('No Subscription Type has been selected. Please enter an access code or choose a plan from <a href="https://www.scottishonlinelessons.com/#signup">https://www.scottishonlinelessons.com/#signup</a>');
                    $('#form-error-label').show();
                    $('#register-form').show();
                    $('#spinner-loading').hide();
                    return;
                }

                $('#register-form').hide();
                $('#spinner-loading').show();
                var errorHTML = '';

                var paymentSessionObject = {

                    firstName: $("#input-firstname").val(),
                    lastName: $("#input-lastname").val(),
                    email: $("#input-email").val(),
                    password: $("#input-password").val(),
                    passwordConfirm: $('#input-confirmpassword').val(),
                    acceptMarketing: $('#input-newsletter').prop("checked"),
                    subscriptionTypeId: parseInt($('#select-plan').val()),
                    hearAbout: $('#input-hearabout').val()
                }

                var data = await lessonsApp.createCustomerPaymentSession(paymentSessionObject);

                if (data.sessionId != null)
                {

                    var stripe = @(Html.Raw(isStripeTest ? "Stripe('pk_test_EbunoXzEjoMoXlgWQzcxnkiM');" : "Stripe('pk_live_MbN9ohZ2EZLr8J98eg5Uq2hx');"))

                        stripe.redirectToCheckout({
                            sessionId: data.sessionId
                        }).then(handleResult);
                    return;

                } else
                {

                    if (data.Errors.length > 0)
                    {

                        errorHTML += '<ul>';

                        data.Errors.forEach(function (item)
                        {
                            errorHTML += '<li>' + item + '</li>';
                        });

                        errorHTML += '</ul>';
                    }
                    else if (data.Errors.length === 1)
                    {
                        errorHTML = data.Errors[0];
                    }
                    else
                    {
                        errorHTML = 'Could not create session. Please contact support';
                    }

                }

                $('#form-error-label').html(errorHTML);
                $('#form-error-label').show();
                $('#register-form').show();
                $('#spinner-loading').hide();

            }
        }

        var handleResult = function (result) {
            if (result.error) {
                showErrorMessage(result.error.message);
                $('#spinner-loading').hide();
            }
        };

    </script>
    
}