@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.LessonItem>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";

    var lessonGroup = Model.Parent as LessonGroup;
}


<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow" data-overlay-dark="0" data-background="@lessonGroup.BackgroundImage.MediaUrl()">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>

                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {


                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
<!-- start course details section -->
<section>
    <div class="container">
        <div class="row">
           
                <!--  start course left-->
            <div class="col-lg-8 col-md-12 sm-margin-40px-bottom ms-margin-30px-bottom">

                <div class="embed-responsive embed-responsive-16by9">
                    <iframe src="//aka.ms/ampembed?url=%2F%2Famssamples.streaming.mediaservices.windows.net%2F3b970ae0-39d5-44bd-b3a3-3136143d6435%2FAzureMediaServicesPromo.ism%2Fmanifest" name="azuremediaplayer" scrolling="no" frameborder="no" align="center" height="280px" width="500px" allowfullscreen></iframe>
                </div>

                <div class="text-center">
                    <img src="img/courses/courses-detail.jpg" class="course-img" alt="" />
                </div>
                <ul class="course-info margin-50px-bottom sm-margin-35px-bottom">
                    <li><i class="icon far fa-calendar-alt"></i> Data TBC</li>
                    <li><i class="icon fa fa-book"></i> Data TBC</li>
                    <li><i class="icon far fa-clock"></i> Data TBC</li>
                </ul>

                <div class="padding-20px-right sm-no-padding-right margin-40px-bottom sm-margin-30px-bottom">
                    <h4 class="margin-15px-bottom">Course Description</h4>
                    @Model.Description
                </div>




            </div>
                <!--  end course left-->
                <!--  start course right-->
                <div class="col-lg-4 col-md-12">


                    <div class="padding-40px-left md-padding-20px-left sm-no-padding-left">

                        <div class="side-bar">

                            <div class="widget-sidebar">

                                <div class="block-info">
                                    <h6 class="bg-yellow">Course Information</h6>

                                    <ul class="list-style12">

                                        <li>
                                            <span class="icon far fa-calendar-alt text-sky font-size20 vertical-align-middle width-40px"></span>Info 1
                                            <span class="float-right font-size14 opacity7"> TBC</span>
                                        </li>
                                        <li>
                                            <span class="icon fas fa-birthday-cake text-yellow font-size20 vertical-align-middle width-40px"></span>Info 2
                                            <span class="float-right font-size14 opacity7">TBC</span>
                                        </li>
                                        <li>
                                            <span class="icon fas fa-anchor text-pink font-size20 vertical-align-middle width-40px"></span>Info 3
                                            <span class="float-right font-size14 opacity7">TBC</span>
                                        </li>
                                        <li>
                                            <span class="icon fas fa-clock text-green font-size20 vertical-align-middle width-40px"></span>Info 4
                                            <span class="float-right font-size14 opacity7">TBC</span>
                                        </li>
                                        <li>
                                            <span class="icon fas fa-user text-orange font-size20 vertical-align-middle width-40px"></span>Info 5
                                            <span class="float-right font-size14 opacity7">TBC</span>
                                        </li>
                                        <li>
                                            <span class="icon fas fa-money-bill-alt text-purple font-size20 vertical-align-middle width-40px"></span>Info 6
                                            <span class="float-right font-size14 opacity7">TBC</span>
                                        </li>

                                    </ul>

                                </div>

                            </div>


                            <div class="widget-sidebar">
                                <div class="event-contact bg-img cover-background theme-overlay border-radius-5" data-overlay-dark="9" data-background="img/content/small-banner.jpg">
                                    <div class="position-relative z-index-9 text-center padding-50px-tb md-padding-40px-tb sm-padding-30px-tb padding-30px-lr">
                                        <i class="fas fa-headset font-size50 md-font-size46 sm-font-size42 text-white margin-15px-bottom"></i>
                                        <h5 class="text-white font-weight-600 margin-5px-bottom">How can we help?</h5>
                                        <p class="text-white font-weight-500">Let’s get in touch!!</p>
                                        <div class="bg-white separator-line-horrizontal-full opacity3 margin-20px-bottom sm-margin-15px-bottom"></div>
                                        <ul class="text-center no-padding no-margin">
                                            <li class="text-white margin-5px-bottom"><i class="fa fa-phone font-size16 text-white margin-15px-right"></i><a href="tel:123456789" class="text-white">(+44) 123 456 789</a></li>
                                            <li class="text-white"><i class="fa fa-envelope-open font-size16 text-white margin-15px-right"></i><a href="mailto:mail@example.com" class="text-white">addyour@emailhere</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!--  end course right-->
            </div>
        </div>
</section>
<!-- end course details section -->