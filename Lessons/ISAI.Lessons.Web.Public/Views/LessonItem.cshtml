@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.LessonItem>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";

    var lessonGroup = Model.Parent as LessonGroup;

    /* Check is logged in */
    if (Request.Cookies["lessons_access_token"] != null && Request.Cookies["lessons_access_token"].Value.ToString().Length > 100)
    {

        ViewBag.LoggedIn = true;

    }
}

@{

    string backgroundImage = "/media/1f3fd5lm/blue-header-background.png";

    if (lessonGroup.BackgroundImage != null)
    {
        backgroundImage = lessonGroup.BackgroundImage.MediaUrl();
    }

}




<!-- start page title section -->
<section class="page-title-section bg-img cover-background p-5" data-overlay-dark="0" data-background="@backgroundImage">
    <div class="container">



        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>

                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {

                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
<!-- start course details section -->
<section class="p-4">
    <div class="container">
        <div class="row">

            <!--  start course left-->
            <div class="col-lg-8 col-md-12 sm-margin-40px-bottom ms-margin-30px-bottom">

                <div class="spinner-border  mb-10" role="status" id="spinner-loading" style="display:none;">
                    <span class="sr-only">Loading...</span>
                </div>

                <div id="panel-nolicence">

                    <div class="alert alert-danger" role="alert" id="alert-nolicence">

                    </div>



                </div>

                <div class="row" id="panel-plans" style="display:none;">
                    @Html.Partial("Partials/_Plans")
                </div>

                @if (ViewBag.LoggedIn != null && ViewBag.LoggedIn == true)
                {

                    <video id="sol-video"
                           class="video-js vjs-fluid"
                           controls
                           preload="auto"
                           width="640"
                           height="400"
                           data-setup="{}">

                        <p class="vjs-no-js">
                            To view this video please enable JavaScript, and consider upgrading to a
                            web browser that
                            <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
                        </p>
                    </video>

                }
                else
                {

                    <div>
                        <a href="/plans"><img class="img-fluid" src="/assets/lessonthumbs/thumb_@(Model.MediaId.Trim()).jpg" alt="Play Video" /></a>
                    </div>
                    <div class="p-5 h4">
                        <a href="/account/?redirectUrl=@(Url.Encode(Model.Url()))"><u> Already a user? Sign In to watch this lesson.</u></a>
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.Description.ToString()))
                {

                    <div class="padding-20px-right sm-no-padding-right margin-40px-bottom margin-100px-top sm-margin-30px-bottom">
                        <h4 class="margin-15px-bottom">Course Description</h4>
                        @Model.Description
                    </div>

                }


                @if (ViewBag.LoggedIn != null && ViewBag.LoggedIn == true)
                {

                

                }


            </div>

            <div class="col-lg-4 col-md-12">
                <div class="padding-40px-left md-padding-20px-left sm-no-padding-left">

                    <div class="side-bar">

                        <div class="widget-sidebar">
                            <div class="block-info">
                                <h6 class="bg-sky">Tutorials</h6>

                                <div class="block-info-details">
                                    <p>Need some help? Book a tutorial for this lesson.</p>

                                    <div class="widget-sidebar search text-center">
                                        <a href="/tutorials/calendar/?lessonId=@Model.MediaId" class="butn x-small sky "><span>Book Tutorial</span></a>

                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="widget-sidebar">

                            <div class="block-info">
                                <h6 class="bg-pink">Resources</h6>

                                <div class="block-info-details">

                                    <div class="media mb-2">
                                        <i class="fas fa-chalkboard-teacher text-pink font-size20 vertical-align-middle width-40px"></i>
                                        <div class="media-body mt-n1">
                                            <a href="#!" class="margin-5px-bottom font-weight-600 text-extra-dark-gray">Workskeet 1</a>
                                            <span class="d-block small">Format: PDF</span>
                                        </div>
                                    </div>

                                    <div class="media mb-2">
                                        <i class="fas fa-chalkboard-teacher text-pink font-size20 vertical-align-middle width-40px"></i>
                                        <div class="media-body mt-n1">
                                            <a href="#!" class="margin-5px-bottom font-weight-600 text-extra-dark-gray">Workskeet 2</a>
                                            <span class="d-block small">Format: PDF</span>
                                        </div>
                                    </div>

                                    <div class="media mb-0">
                                        <i class="fas fa-chalkboard-teacher text-pink font-size20 vertical-align-middle width-40px"></i>
                                        <div class="media-body mt-n1">
                                            <a href="#!" class="margin-5px-bottom font-weight-600 text-extra-dark-gray">Workskeet 3</a>
                                            <span class="d-block small">Format: PDF</span>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="widget-sidebar">
                            <div class="block-info">
                                <h6 class="bg-yellow">Assesments</h6>
                                <div class="block-info-details">

                                    <div class="media mb-0">
                                        <i class="fas fa-chalkboard-teacher text-yellow font-size20 vertical-align-middle width-40px"></i>
                                        <div class="media-body mt-n1">
                                            <a href="#!" class="margin-5px-bottom font-weight-600 text-extra-dark-gray">Take Assesment</a>
                                            <span class="d-block small">12 Questions</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="widget-sidebar mt-4">
                            <div class="block-info">
                                <h6 class="bg-sky">Ask a Question</h6>

                                <div class="block-info-details m-2 p-2">

                                    <div class="widget-sidebar">

                                        <div class="mb-2">

                                            <p>If you have any questions about this lesson, please complete the form below. We will do our best to help</p>

                                        </div>

                                        <form method="post" id="contact-form">
                                            <div class="row">

                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label>Name *:</label>
                                                        <input type="text" class="form-control" name="input-name" id="input-name" required />
                                                    </div>
                                                </div>
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <label>Email Address *:</label>
                                                        <input type="email" class="form-control" name="input-email" id="input-email" required />
                                                    </div>
                                                </div>


                                                <div class="col-md-12">
                                                    <label>Ask your question below *:</label>
                                                    <div class="form-group">
                                                        <textarea rows="4" class="form-control" name="input-message" id="input-message" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-md-12 text-center mt-2">
                                                    <button type="button" onclick="SendMessage();" class="butn x-small sky">Send Message</button>
                                                </div>
                                            </div>
                                        </form>

                                        <div class="spinner-border  mb-10" role="status" id="spinner-loading" style="display:none;">
                                            <span class="sr-only">Loading...</span>
                                        </div>


                                        <div id="label-sent" class="alert alert-success alert-dismissible fade show mt-4" role="alert" style="display:none;">
                                            Your message has been sent

                                        </div>

                                        <div id="label-error" class="alert alert-danger delivery-error-label  mt-4" role="alert" style="display:none;">
                                            We could not send your message at this time
                                        </div>


                                    </div>

                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end course details section -->


@section Head {

    <link href="https://vjs.zencdn.net/8.16.1/video-js.css" rel="stylesheet" />



}

@section Scripts {



    @if (ViewBag.LoggedIn != null && ViewBag.LoggedIn == true)
    {

        <script src="https://vjs.zencdn.net/8.16.1/video.min.js"></script>

        <script>


            $(document).ready(function () {
                $("#panel-nolicence").hide();


            });

    function initFingerprintJS() {
        FingerprintJS.load().then(fp => {
            fp.get().then(result => {
                LessonsApp.visitorId = result.visitorId;
                //console.log(LessonsApp.visitorId);
                SetLessonUrl();
            });
        });
            }



        function ToggleLessonNotes() {

            $("#lesson-notes").toggleClass('d-none');

            if ($("#notes-button-label").text === 'Show Notes') {
                $("#notes-button-label").text('Hide Notes');
            } else {
                $("#notes-button-label").text('Show Notes');
            }

        }

        async function SetLessonUrl() {

            $('#spinner-loading').show();

            var model = {

                LessonId: @Model.MediaId,
                CustomerDevice: {
                    DeviceIdentifier: LessonsApp.visitorId
                }

            };

            //TODO: remove stars
            var myPlayer = videojs('sol-video', {
                fill: true
            });

            myPlayer.src({ type: 'video/mp4', src: 'https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/1080/Big_Buck_Bunny_1080_10s_1MB.mp4' });
            $('#spinner-loading').hide();
            return;
            //TODO: remove ends

            var data = await lessonsApp.lessonStreamingUrl(model);

            $('#spinner-loading').hide();

            if (data) {

                if (data.Status == 0) {

                    $("#lessonplayer").show();

                    var myPlayer = videojs('sol-video', {
                        fill: true
                    });
                    myPlayer.src({
                        type: 'application/x-mpegURL',
                        src: data.Content.StreamingUrl,
                    
                    });
                   
                    return;

                } else if(data.ErrorResponse) {

                    $("#lessonplayer").hide();
                    $("#alert-nolicence").html(data.ErrorResponse[0].Message);
                    $("#alert-nolicence").show();
                    $("#panel-nolicence").show();
                    return;
                }

            }


            $("#lessonplayer").hide();
            var errorHtml = 'You do not have a licence to view this lesson or your trial licence has expired. To get a licence please, <a href="/plans"><u>Subscribe Here</u></a>';
            $("#alert-nolicence").html(errorHtml);
            $("#alert-nolicence").show();
            $("#panel-nolicence").show();

            $("#panel-plans").show();

        }


        </script>

        <script async
                src="~/scripts/fp.min.js"
                onload="initFingerprintJS()"></script>

    }
    else
    {
        <script>

            $(document).ready(function ()
            {
                $("#panel-nolicence").hide();
            });

        </script>
    }


    <script>

            async function SendMessage() {

                var form = document.getElementById("contact-form");

                if (form.checkValidity() === false) {

                    event.preventDefault();
                    event.stopPropagation();
                    form.classList.add('was-validated');

                } else {

                    $('#contact-form').hide();
                    $('#label-error').hide();
                    $('#spinner-loading').show();

                    var message = $('#input-message').val();
                    message += "<br /><br /><strong>Lesson Details</strong>"
                    message += "<br /> @(Model.Name.Replace("\"", ""))";
                    message += "<br />https://scottishonlinelessons.com/@(Model.Url())";

                    var emailModel = {

                        Name: $('#input-name').val(),
                        Email: $('#input-email').val(),
                        Subject: "Lesson Question Form",
                        Message: message

                    };

                    var data = await lessonsApp.sendEmail(emailModel);

                    if (data.Status === 0) {


                        $('#label-sent').show();
                        $('#spinner-loading').hide();

                    } else {
                        $('#contact-form').show();
                        $('#label-error').show();
                        $('#spinner-loading').hide();

                    }


                }

            }

    </script>

}