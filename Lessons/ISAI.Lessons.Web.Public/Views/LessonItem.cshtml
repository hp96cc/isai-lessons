@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.LessonItem>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";

    var lessonGroup = Model.Parent as LessonGroup;

    /* Check is logged in */
    if (Request.Cookies["lessons_access_token"] != null && Request.Cookies["lessons_access_token"].Value.ToString().Length > 100)
    {

        ViewBag.LoggedIn = true;

    }
}


<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow  p-5" data-overlay-dark="0" data-background="@lessonGroup.BackgroundImage.MediaUrl()">
    <div class="container">
        <div class="page-title">
            <h1>@Model.Title</h1>
            <div class="page-link">
                <ul>

                    @{

                        var ancestors = Model.Ancestors().Reverse().ToList();

                        foreach (var ancestor in ancestors)
                        {

                            if (ancestor.Id == Model.Root().Id)
                            {
                                <li><a href="/">Home</a></li>
                            }
                            else
                            {
                                <li>
                                    <a href="@ancestor.Url()">@ancestor.Name</a>
                                </li>
                            }

                        }


                    }
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
