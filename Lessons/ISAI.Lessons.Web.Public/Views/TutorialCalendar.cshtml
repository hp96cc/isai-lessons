@inherits Umbraco.Web.Mvc.UmbracoViewPage<ContentModels.TutorialCalendar>
@using ContentModels = Umbraco.Web.PublishedModels;
@{
    Layout = "Master.cshtml";
}


<!-- start page title section -->
<section class="page-title-section bg-img cover-background bg-yellow p-5" data-overlay-dark="0">
    <div class="container">
        <div class="page-title">
            <h1>Book Tutorial TBC</h1>
            <div class="page-link">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="javascript:void(0)">Book Tutorial TBC</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- end page title section -->
<!-- start service details section -->
<section class="pb-2">
    <div class="container">

        <div class="row">

            <div class="margin-40px-bottom sm-margin-30px-bottom">
                <div class="row align-items-center">
                    <div class="col-12  xs-margin-25px-bottom">
                      <div id="Schedule"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>



</section>

<div class="modal fade" id="confirmTutorialTimeSlotModal" tabindex="-1" role="dialog" aria-labelledby="deleteDeviceModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteDeviceModalLabel">Confirm Time Slote</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you wish to delete this device? You will no longer be able to access any lesson content on this device after it has been deleted.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" onclick="DeleteDevice();">Yes</button>
            </div>
        </div>
    </div>
</div>



@section Head {

    <link href="https://cdn.syncfusion.com/ej2/22.1.34/material.css" rel="stylesheet" type="text/css" />


}

@section Scripts {

    <script src="https://cdn.syncfusion.com/ej2/22.1.34/dist/ej2.min.js" type="text/javascript"></script>

    <script>


        $(document).ready(function ()
        {

            var scheduleObj = new ej.schedule.Schedule({
                height: '550px',
                allowDragAndDrop: false,
                allowInline: false,
                cellClick: function (args)
                {
                    args.cancel = true;
                    ShowConfirmationDialog(args.startTime, args.endTime);
                    
                },
                cellDoubleClick: function (args)
                {
                    args.cancel = true;
                    ShowConfirmationDialog(args.startTime, args.endTime);
                },
          

            });
            scheduleObj.appendTo('#Schedule');

        });


        function ShowConfirmationDialog(startTime, endTime)
        {
            alert('Event from ' + startTime + ' to ' + endTime);
        }



    </script>

}