<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ISAI.Lessons.Mobile.Views.AboutPage"
             xmlns:vm="clr-namespace:ISAI.Lessons.Mobile.ViewModels"
             Title="Scottish Online Lessons">

    <ContentPage.Content>
        <StackLayout Padding="20" VerticalOptions="StartAndExpand">


            <Image
                    Source="logo.png"
                    WidthRequest="250"
                    Margin="10,50,10,50"
                
                    />

        
            <Button 
                Margin="10"
                VerticalOptions="Center" 
                Text="Browse Lessons" 
                Clicked="Button_Lessons_Clicked" />


            <Button 

                Margin="10"
                VerticalOptions="Center" 
                Text="Downloaded Lessons"
                Clicked="Button_Downloads_Clicked" />


            <Button 

                Margin="10"
                VerticalOptions="Center" 
                Text="Refresh Lesson Data"
                Clicked="Button_Refresh_Clicked" />


            <Label
                Margin="5,20,5,0"
                x:Name="LabelAppVersion"
                VerticalOptions="Center" 
                HorizontalTextAlignment="Center"
                Text="App Version: " />


            <Label
                Margin="5,0,5,0"
                x:Name="LabelDeviceData"
                VerticalOptions="Center" 
                HorizontalTextAlignment="Center"
                Text="Device: " />

        </StackLayout>
    </ContentPage.Content>
</ContentPage>