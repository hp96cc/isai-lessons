<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ISAI.Lessons.Mobile.Views.LessonPage"
             Title="{Binding Title}"
             >
 
    <ContentPage.Content>
        <StackLayout Padding="20" >
            <Label 
                FontSize="20"
                Text="{Binding Lesson.Name}"
                Margin="10,0,0,0"

                />
            
            <Label 
                Text="{Binding Breadcrumb}"
                FontSize="14"
                FontAttributes="Bold"
                Margin="10,0,0,30"/>

            <Button
                Margin="10"
                VerticalOptions="Center" 
                Text="Watch Lesson"
                Command="{Binding WatchCommand}" />

            <Button
                Margin="10"
                VerticalOptions="Center" 
                Text="Download Lesson"
                Command="{Binding DownloadCommand}"
                IsEnabled="{Binding CanDownload}"
                
                />
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>