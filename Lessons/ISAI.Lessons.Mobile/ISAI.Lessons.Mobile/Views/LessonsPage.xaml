<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ISAI.Lessons.Mobile.Views.LessonsPage"
             Title="{Binding Title}"
             xmlns:local="clr-namespace:ISAI.Lessons.Mobile.ViewModels"  
             xmlns:model="clr-namespace:ISAI.Lessons.Models.Models.App;assembly=ISAI.Lessons.Models"  
             >

   <CollectionView x:Name="ItemsListView"
                ItemsSource="{Binding Items}"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" x:DataType="model:Lesson">
                        <Label Text="{Binding Name}" 
                            LineBreakMode="WordWrap" 
                            
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="5,5,5,10"   
                               />

                        <BoxView HeightRequest="0.5"
                                BackgroundColor="LightGray"
                                VerticalOptions="End"/>

                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer 
                                NumberOfTapsRequired="1"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:LessonsViewModel}}, Path=ItemTapped}"		
                                CommandParameter="{Binding .}">
                            </TapGestureRecognizer>
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
  
</ContentPage>
