<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ISAI.Lessons.Mobile.Views.LessonsPage"
             xmlns:model="clr-namespace:ISAI.Lessons.Models.Models.App;assembly=ISAI.Lessons.Models"  
             >


    <ContentPage.Resources>
        <Style TargetType="StackLayout">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                     Value="LightGray" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <CollectionView x:Name="ItemsListView"
                SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" x:DataType="model:Lesson">
                        <Label Text="{Binding Name}" 
                            LineBreakMode="WordWrap" 
                            
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="5,5,5,10"   
                               />

                        <BoxView HeightRequest="0.5"
                                BackgroundColor="LightGray"
                                VerticalOptions="End"/>

                       
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
  
</ContentPage>
