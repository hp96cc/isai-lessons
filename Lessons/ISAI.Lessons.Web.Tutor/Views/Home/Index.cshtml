@{
    ViewBag.Title = "Home Page";
}


<div id="row-lesson" class="row">
    <div class="col-md-12">
        <h2>Select Subject and Lesson</h2>

      
        <input type="text" tabindex="1" id='input-subject' />
        <br /> <br />
        <input type="text" tabindex="1" id='input-lesson' />
        <br /> <br />

        <button type="button" onclick="MoveToScheduleSelection();" class="btn btn-primary">Choose Time Slot</button>

    </div>

</div>

<div id="row-schedule" class="row">
    <div class="col-md-12">
        <h2>Select Time Slot</h2>
        <div id="Schedule"></div>
        <br /> <br />
        <button type="button" onclick="MoveToLessonSelection();" class="btn btn-secondary">Back</button>
        <button type="button" onclick="MoveToSummary();" class="btn btn-primary">Confirm Time Slot</button>
    </div>

</div>


<div id="row-confirm" class="row">
    <div class="col-md-12">
        <h2>Confirm Tutorial</h2>

        <p>Please confirm the tutiorial details below. If you are happy with them please click 'Confirm and Pay'</p>
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <tbody>
                    <tr>
                        <th class="text-nowrap col-md-2" scope="row">Subject / Lesson</th>
                        <td>Maths - Some Lesson Name</td>

                    </tr>
                    <tr>
                        <th class="text-nowrap col-md-2" scope="row">Date and Time</th>
                        <td>Friday 14th November at 14:00</td>

                    </tr>

                    <tr>
                        <th class="text-nowrap col-md-2" scope="row">Total Cost</th>
                        <td>£10.00</td>

                    </tr>

                </tbody>
            </table>
        </div>

        <button type="button" onclick="MoveToScheduleSelection();" class="btn btn-secondary">Back</button>
        <button type="button" onclick="MoveToDetails();" class="btn btn-primary">Confirm and Pay</button>
    </div>

</div>

<div id="row-details" class="row">
    <div class="col-md-12">
        <h2>Enter Details</h2>
        <p>Do you have a Scottish Online Lessons account?</p>

        <button type="button" onclick="MoveToLogin();" class="btn btn-success btn-block">Yes, I have an account</button>
        <button type="button" onclick="MoveToRegistration();" class="btn btn-warning btn-block">No, I do not have an account</button>
        <br /> <br />
        <button type="button" onclick="MoveToSummary();" class="btn btn-secondary">Back</button>

    </div>

</div>

<div id="row-login" class="row">
    <div class="col-md-12">
        <h2>Login</h2>

            <!-- Heading -->
            <p class="pb-0 mb-3"><strong>To access your account please sign in below:</strong></p>

            <!-- Form -->
            <form id="login-form" class="needs-validation" novalidate="">
                <div class="row">
                    <div class="col-12">

                        <!-- Email -->
                        <div class="form-group">
                            <label class="sr-only" for="loginEmail">
                                Email Address *
                            </label>
                            <input class="form-control form-control-sm" id="loginEmail" type="email" placeholder="Email Address *" required="">
                        </div>

                    </div>
                    <div class="col-12">

                        <!-- Password -->
                        <div class="form-group">
                            <label class="sr-only" for="loginPassword">
                                Password *
                            </label>
                            <input class="form-control form-control-sm" id="loginPassword" type="password" placeholder="Password *" required="">
                        </div>

                    </div>
                    <div class="col-12 col-md">
                        <!-- Remember -->
                        <div class="form-group">
                            <div class="custom-control custom-checkbox">
                                <input class="custom-control-input" id="loginRemember" type="checkbox">
                                <label class="custom-control-label" for="loginRemember">
                                    Remember me
                                </label>
                            </div>
                        </div>

                    </div>
                    <div class="col-12 col-md-auto">
                        <div class="form-group">
                            <a class="font-size-sm text-reset" href="/forgot-password"><u>Forgot Password?</u></a>
                        </div>

                    </div>
                    <div class="col-12 d-flex justify-content-center">

                        <div id="login-error-label" class="alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">
                            Username and/or password are not correct
                        </div>

                        <button type="button" onclick="MoveToDetails();" class="btn btn-secondary">Back</button>
                        <button type="button" onclick="MoveToPayment();" class="btn btn-primary">Sign In</button>
                    </div>
                </div>
            </form>

        </div>

 

</div>


<div id="row-register" class="row">
    <div class="col-md-12">
        <h2>Registration</h2>
        <div class="block-info">

            <h6 class="bg-sky">Your Details</h6>

            <div class="padding-50px-all md-padding-50px-all sm-padding-25px-all">

                <div class="spinner-border  mb-10" role="status" id="spinner-loading" style="display:none;">
                    <span class="sr-only">Loading...</span>
                </div>

                <form method="post" id="register-form" class="needs-validation" novalidate="">

                    <input type="hidden" name="input-priceid" id="input-priceid" value="price_1IxXTvJ81SbG6nzajuriP6XZ">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Firstname *:</label>
                                <input type="text" class="form-control" id="input-firstname" name="input-firstname" placeholder="First Name" autocomplete="none" required="">
                                <div class="invalid-feedback">Firstname is required</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Surname *:</label>
                                <input type="text" class="form-control" id="input-lastname" name="input-lastname" placeholder="Surname" autocomplete="none" required="">
                                <div class="invalid-feedback">Surname is required</div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Email *:</label>
                                <input type="email" class="form-control" id="input-email" name="input-email" placeholder="name@email.com" autocomplete="none" required="">
                                <div class="invalid-feedback">Email is required</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Password *:</label>
                                <input type="password" class="form-control" id="input-password" name="input-password" placeholder="Password" autocomplete="new-password" required="">
                                <div class="invalid-feedback">Password is required</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Confirm Password *:</label>
                                <input type="password" class="form-control" id="input-confirmpassword" name="input-confirmpassword" placeholder="Confirm Password" autocomplete="new-password" required="">
                                <div class="invalid-feedback">Confirm Password is required</div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label>How did you hear about us?</label>
                                <input type="text" class="form-control" id="input-hearabout" placeholder="e.g. Google, Facebook, Daily Record" name="input-hearabout" autocomplete="none">

                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="input-newsletter">
                                <label class="custom-control-label" for="input-newsletter">Accept emails for updates and offers?</label>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="input-terms-condition" required="">
                                <label class="custom-control-label" for="input-terms-condition">I agree to the <a href="#!">Terms &amp; Conditions</a></label>
                                <span class="invalid-feedback">You must agree before submitting.</span>

                            </div>
                        </div>

                        <div class="col-md-12" id="div-input-toggleaccesscode">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="checkbox-accesscode" onchange="ToggleAccessCode();">
                                <label class="custom-control-label" for="checkbox-accesscode">I have an access code</label>
                                <span class="invalid-feedback">Access code invalid.</span>

                            </div>
                        </div>

                        <div class="col-md-12" id="div-input-accesscode" style="display:none;">
                            <div class="form-group">
                                <label>Access Code *:</label>
                                <input type="text" class="form-control" id="input-accesscode" name="input-accesscode" autocomplete="none">
                                <div class="invalid-feedback">Access code is required</div>
                            </div>
                        </div>


                        <div id="form-error-label" class="col-md-12 alert alert-danger m-3 delivery-error-label" role="alert" style="display:none;">

                        </div>



                        <div class="col-md-12 margin-35px-top sm-margin-25px-top">
                            <button type="button" id="button-checkout" onclick="GoToPayment();" class="butn yellow small btn-block p-2 pl-4 pr-4 mb-2 mt-2">Go To Payment</button>
                            <button type="button" id="button-activate" style="display:none;" onclick="Activate();" class="butn yellow small btn-block p-2 pl-4 pr-4 mb-2 mt-2">Activate Access Code</button>

                        </div>

                        <div class="col-md-12 text-center margin-25px-top">
                            <span>Already have an account? <a href="/account">Login</a></span>
                        </div>

                    </div>
                </form>

            </div>
        </div>
        <button type="button" onclick="MoveToDetails();" class="btn btn-secondary">Back</button>
        <button type="button" onclick="MoveToPayment();" class="btn btn-primary">Next</button>
    </div>

</div>



<div id="row-payment" class="row">
    <div class="col-md-12">
        <h2>Payment</h2>
    </div>

</div>


