@model IEnumerable<ISAI.Lessons.EntityFramework.Models.User>



<div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-sm-4">
        <h2>@ViewBag.Title</h2>
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">
                <strong>@string.Format("{0}s", ViewBag.ItemName)</strong>
            </li>
        </ol>
    </div>
</div>


<div class="wrapper wrapper-content animated fadeInRight">

    <div class="row">
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>List of @string.Format("{0}s", ViewBag.ItemName)</h5>
                    <div class="ibox-tools">
                        &nbsp;
                    </div>
                </div>
                <div class="ibox-content">

                    <div class="sk-spinner sk-spinner-wave">
                        <div class="sk-rect1"></div>
                        <div class="sk-rect2"></div>
                        <div class="sk-rect3"></div>
                        <div class="sk-rect4"></div>
                        <div class="sk-rect5"></div>
                    </div>

                    <div id="Grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Header {


}
@section Scripts {

    <script type="text/javascript" src="~/Scripts/views/user-index.js?v=1"></script>

}
