<div class="modal inmodal fade" id="taskflowchangeScanModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
                <h4 class="modal-title">Task Flow Change Scan</h4>
                <p>A scan to confirm reasons for changing a Task Flow</p>
            </div>
            <div class="modal-body">


                <div class="form-group" id="scan-taskflowchange-user">

                    <h4 id="scan-taskflowchange-label">Scan User</h4>
                    <input type="text" id="scan-taskflowchange-value" class="form-control">

                </div>


                <div class="form-group" id="scan-taskflowchange-form">

                    <h4 id="scan-taskflowchange-label">Reason given for chaning Task Flow</h4>
                    <input type="text" id="scan-taskflowchange-reason" class="form-control">

                </div>

                <div id="scan-taskflowchange-error" class="alert alert-danger"></div>
            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-white" data-dismiss="modal">Close</button>
                <button type="button" id="scan-taskflowchange-button-save" class="btn btn-primary" onclick="UpdateTaskFlowChangeScanState();">&nbsp;&nbsp;&nbsp;Save Form&nbsp;&nbsp;&nbsp;</button>
            </div>
        </div>
    </div>
</div>


