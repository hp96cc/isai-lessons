    <script>

        function loadCultureFiles(name, currency) {
            var files = ['ca-gregorian.json', 'numbers.json', 'timeZoneNames.json', 'currencies.json'];
            var loadCulture = function (prop) {
                var val, ajax;
                ajax = new ej.base.Ajax('/scripts/cldr-data/main/' + name + '/' + files[prop], 'GET', false);
                ajax.onSuccess = function (value) {
                    val = value;
                };
                ajax.send();
                ej.base.loadCldr(JSON.parse(val));
                ej.base.setCulture(name);
                ej.base.setCurrencyCode(currency);
            };
            for (var prop = 0; prop < files.length; prop++) {
                loadCulture(prop);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            loadCultureFiles('en-GB', 'GBP');


        });

        @*@{ 

            var info = TimeZoneInfo.FindSystemTimeZoneById("GMT Standard Time");
            DateTimeOffset localServerTime = DateTimeOffset.Now;
            var offset = info.GetUtcOffset(localServerTime).Hours * 1;

        }

        //HACK: The system is always set to display times for current time in UK
        //ej.data.DataUtil.serverTimezoneOffset = @offset;*@

        function uuidv4() {
            return ([1e7] + -1e3 + -4e3 + -8e3 + -1e11).replace(/[018]/g, c =>
                (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
            )
        }

    </script>




